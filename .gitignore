# Python
__pycache__/
*.pyc
.pytest_cache/

# Project-local virtualenv (llvmlite)
.venv/

# C build artifacts
*.o
*.a
runtime/runtime_test
runtime/runtime_test_asan
runtime/coro_drv
runtime/*.exe

# Compiled fray binaries
*.exe
tests/cases/*.exe

# Scratch / debug output
*.ll
tmp_ir.ll
fray_test_output.ll
/selfhosted_ir.ll
/python_ir.ll

# Release staging
dist/*
!dist/.gitkeep

# Desktop app metadata (local project id, not project source)
/.freebuff/

# build/ holds one piece of source and a pile of output. gates.sh is the
# canonical entry point for the whole suite and is tracked; everything else
# is a compiled driver (build/frayc_driver, rebuilt by tools/frayc.sh) or a
# run log, and is regenerated by build/gates.sh on every run.
build/*
!build/gates.sh

# Scratch programs and captured stderr left over from debugging sessions.
/async_test.fray
/bisect.fray
/scope_test.fray
/scope_test2.fray
/scope_test3.fray
/scope_test4.fray
/err_mb.txt
/err_sn.txt
