# compiler/codegen.fray — Self-hosted LLVM IR text emitter for fray
#
# Generates LLVM IR as text from the dict-based AST produced by parser.fray.
# The IR is then compiled by llvmlite (Python side) into native binaries.
#
# Usage: import parser, codegen; ir_text = codegen.compile_ir(ast)

import parser

# ─── IR Builder state ───

struct IRBuilder:
    lines
    var_counter
    block_counter
    func_counter
    str_counter
    string_consts
    string_encoded
    global_vars
    func_vars
    ret_slots
    current_block_name
    in_func
    struct_defs
    enum_defs
    loop_break
    loop_continue
    postamble
    func_names
    func_arities
    extern_names
    extern_defs
    modules
    in_async
    async_fns
    name_counter
    # 1 while generating an `i8*`-returning function body, 0 in main (which
    # returns i32). A `return` in a try body can only be parked and handed back
    # where there is an i8* result to hand back.
    ret_i8
    # The try a `return` in the statement being generated belongs to (empty
    # strings outside one). See gen_deferred_return: the return parks its value
    # in try_park, marks try_flag, and leaves through try_finally so a pending
    # exception reaches the matching clause first and the finally still runs.
    try_dispatch
    try_finally
    try_park
    try_flag
    # ── Unboxed slots (see "Type inference for unboxed slots") ──
    # infer: the whole-program inference result; cur_fn: the function being
    # generated ("" at module scope, where nothing is unboxed); var_tys: that
    # function's proven slot types; slot_kinds: the names that got a machine
    # slot and which kind each is; raw_vars: their allocas. `func_vars` holds
    # boxed slots only, so every site that loads or stores a slot has to know
    # which of the two it is looking at.
    infer
    cur_fn
    var_tys
    slot_kinds
    raw_vars


def make_ir():
    b = IRBuilder()
    b.lines = []
    b.var_counter = 0
    b.block_counter = 0
    b.func_counter = 0
    b.str_counter = 0
    b.string_consts = []
    b.string_encoded = []
    b.global_vars = {}
    b.func_vars = {}
    b.ret_slots = []
    b.current_block_name = ""
    b.in_func = False
    b.struct_defs = {}
    b.enum_defs = {}
    b.loop_break = ""
    b.loop_continue = ""
    b.postamble = []
    b.func_names = {}
    b.func_arities = {}
    b.extern_names = {}
    b.extern_defs = {}
    b.modules = {}
    b.in_async = 0
    b.async_fns = {}
    b.name_counter = 0
    b.ret_i8 = 0
    b.try_dispatch = ""
    b.try_finally = ""
    b.try_park = ""
    b.try_flag = ""
    b.infer = null
    b.cur_fn = ""
    b.var_tys = {}
    b.slot_kinds = {}
    b.raw_vars = {}
    return b

def is_terminated(b):
    # True when the current block already ends in a terminator (ret/br),
    # so no further branch may be emitted into it.
    return b.lines[len(b.lines) - 1].startswith("  ret ") or b.lines[len(b.lines) - 1].startswith("  br ")

def emit(b, line):
    b.lines.append(line)

def emit_global(b, line):
    b.postamble.append(line)

def fresh_var(b):
    b.var_counter = b.var_counter + 1
    return "%" + str(b.var_counter)

def fresh_block(b, prefix):
    b.block_counter = b.block_counter + 1
    return prefix + "_" + str(b.block_counter)

def fresh_name(b, prefix):
    # A *named* temporary: an alloca or value that must be referred to by name
    # (one created before a merge block and read inside it, say). LLVM's parser
    # assigns unnamed temporaries their numbers strictly — each function's
    # temporaries must run %0, %1, %2 … with nothing skipped — so a value that
    # needs a name cannot take its number from fresh_var: the number would be
    # consumed and never appear, and `llc` rejects the module with
    # "instruction expected to be numbered '%N'". (llvmlite tolerated that; the
    # modules are compared byte-for-byte through `llc`, so it is not an option.)
    # The dot keeps these names out of the identifier space fray programs can
    # write, and the counter is module-wide, so no two are ever the same.
    b.name_counter = b.name_counter + 1
    return "%" + prefix + "." + str(b.name_counter)

def get_string_const(b, s):
    i = 0
    while i < len(b.string_consts):
        if b.string_consts[i] == s:
            return i + 1
        i = i + 1
    b.string_consts.append(s)
    return len(b.string_consts)

# ─── Runtime function declarations ───

def emit_decl(b, name, ret, params):
    emit(b, "declare " + ret + " @\"" + name + "\"(" + params + ")")

def emit_runtime_decls(b):
    emit_decl(b, "fray_int", "i8*", "i64")
    emit_decl(b, "fray_float", "i8*", "double")
    emit_decl(b, "fray_bool", "i8*", "i1")
    emit_decl(b, "fray_string_copy", "i8*", "i8*")
    emit_decl(b, "fray_none", "i8*", "")
    emit_decl(b, "fray_list", "i8*", "")
    emit_decl(b, "fray_tuple", "i8*", "i64")
    emit_decl(b, "fray_set", "i8*", "")
    emit_decl(b, "fray_set_append", "void", "i8*, i8*")
    emit_decl(b, "fray_add", "i8*", "i8*, i8*")
    emit_decl(b, "fray_sub", "i8*", "i8*, i8*")
    emit_decl(b, "fray_mul", "i8*", "i8*, i8*")
    emit_decl(b, "fray_div", "i8*", "i8*, i8*")
    emit_decl(b, "fray_floordiv", "i8*", "i8*, i8*")
    emit_decl(b, "fray_mod", "i8*", "i8*, i8*")
    emit_decl(b, "fray_pow", "i8*", "i8*, i8*")
    emit_decl(b, "fray_neg", "i8*", "i8*")
    emit_decl(b, "fray_eq", "i8*", "i8*, i8*")
    emit_decl(b, "fray_neq", "i8*", "i8*, i8*")
    emit_decl(b, "fray_lt", "i8*", "i8*, i8*")
    emit_decl(b, "fray_gt", "i8*", "i8*, i8*")
    emit_decl(b, "fray_lte", "i8*", "i8*, i8*")
    emit_decl(b, "fray_gte", "i8*", "i8*, i8*")
    emit_decl(b, "fray_and", "i8*", "i8*, i8*")
    emit_decl(b, "fray_or", "i8*", "i8*, i8*")
    emit_decl(b, "fray_xor", "i8*", "i8*, i8*")
    emit_decl(b, "fray_xnor", "i8*", "i8*, i8*")
    emit_decl(b, "fray_not", "i8*", "i8*")
    emit_decl(b, "fray_is_truthy", "i1", "i8*")
    emit_decl(b, "fray_print", "void", "i8*")
    emit_decl(b, "fray_print_sep", "void", "i8*")
    emit_decl(b, "fray_print_end", "void", "")
    emit_decl(b, "fray_len", "i8*", "i8*")
    emit_decl(b, "fray_abs", "i8*", "i8*")
    emit_decl(b, "fray_sqrt", "i8*", "i8*")
    emit_decl(b, "fray_isqrt", "i8*", "i8*")
    emit_decl(b, "fray_round_val", "i8*", "i8*")
    emit_decl(b, "fray_ord", "i8*", "i8*")
    emit_decl(b, "fray_chr", "i8*", "i8*")
    emit_decl(b, "fray_sum", "i8*", "i8*")
    emit_decl(b, "fray_min", "i8*", "i8*, i8*")
    emit_decl(b, "fray_max", "i8*", "i8*, i8*")
    emit_decl(b, "fray_mean", "i8*", "i8*")
    emit_decl(b, "fray_med", "i8*", "i8*")
    emit_decl(b, "fray_mid", "i8*", "i8*")
    emit_decl(b, "fray_mode", "i8*", "i8*")
    emit_decl(b, "fray_int_val", "i8*", "i8*")
    emit_decl(b, "fray_float_val", "i8*", "i8*")
    emit_decl(b, "fray_str_val", "i8*", "i8*")
    emit_decl(b, "fray_range", "i8*", "i8*")
    emit_decl(b, "fray_range3", "i8*", "i8*, i8*, i8*")
    emit_decl(b, "fray_list_append", "void", "i8*, i8*")
    emit_decl(b, "fray_list_depend", "i8*", "i8*")
    emit_decl(b, "fray_append", "void", "i8*, i8*")
    emit_decl(b, "fray_depend", "i8*", "i8*")
    emit_decl(b, "fray_list_index", "i8*", "i8*, i64")
    emit_decl(b, "fray_tuple_index", "i8*", "i8*, i64")
    emit_decl(b, "fray_list_setindex", "void", "i8*, i64, i8*")
    emit_decl(b, "fray_string_concat", "i8*", "i8*, i8*")
    emit_decl(b, "fray_string_repeat", "i8*", "i8*, i64")
    emit_decl(b, "fray_string_index", "i8*", "i8*, i64")
    emit_decl(b, "fray_string_upper", "i8*", "i8*")
    emit_decl(b, "fray_string_lower", "i8*", "i8*")
    emit_decl(b, "fray_string_trim", "i8*", "i8*")
    emit_decl(b, "fray_string_find", "i8*", "i8*, i8*")
    emit_decl(b, "fray_string_replace", "i8*", "i8*, i8*, i8*")
    emit_decl(b, "fray_string_split", "i8*", "i8*, i8*")
    emit_decl(b, "fray_string_startswith", "i8*", "i8*, i8*")
    emit_decl(b, "fray_string_endswith", "i8*", "i8*, i8*")
    emit_decl(b, "fray_init_args", "void", "i32, i8**")
    emit_decl(b, "fray_prog_name", "i8*", "")
    emit_decl(b, "fray_argv", "i8*", "")
    emit_decl(b, "fray_file_read", "i8*", "i8*")
    emit_decl(b, "fray_file_exists", "i8*", "i8*")
    emit_decl(b, "fray_file_write", "void", "i8*, i8*")
    emit_decl(b, "fray_list_dir", "i8*", "i8*")
    emit_decl(b, "fray_is_dir", "i8*", "i8*")
    emit_decl(b, "fray_exit_val", "void", "i8*")
    emit_decl(b, "fray_release", "void", "i8*")
    emit_decl(b, "fray_retain", "void", "i8*")
    emit_decl(b, "fray_as_int", "i64", "i8*")
    emit_decl(b, "fray_as_float", "double", "i8*")
    emit_decl(b, "fray_as_string", "i8*", "i8*")
    # input/inputStr read a line; each takes an optional prompt, which the
    # runtime wants as a C string (the box is unwrapped at the call site).
    emit_decl(b, "fray_input", "i8*", "")
    emit_decl(b, "fray_input_str", "i8*", "i8*")
    emit_decl(b, "fray_input_int", "i8*", "")
    emit_decl(b, "fray_input_int_str", "i8*", "i8*")
    emit_decl(b, "fray_input_float", "i8*", "")
    emit_decl(b, "fray_input_float_str", "i8*", "i8*")
    emit_decl(b, "fray_contains", "i8*", "i8*, i8*")
    emit_decl(b, "fray_function", "i8*", "i8*, i8*, i32")
    emit_decl(b, "fray_call", "i8*", "i8*, i8*")
    emit_decl(b, "fray_call_args", "i8*", "")
    emit_decl(b, "fray_call_result_store", "void", "i8*")
    emit_decl(b, "fray_struct_new", "i8*", "i8*, i64, i8*")
    emit_decl(b, "fray_struct_new_boxed", "i8*", "i8*, i8*")
    emit_decl(b, "fray_struct_field_get", "i8*", "i8*, i8*")
    emit_decl(b, "fray_struct_field_set", "void", "i8*, i8*, i8*")
    emit_decl(b, "fray_map_new", "i8*", "")
    emit_decl(b, "fray_map_get", "i8*", "i8*, i8*")
    emit_decl(b, "fray_map_set", "void", "i8*, i8*, i8*")
    emit_decl(b, "fray_map_has", "i8*", "i8*, i8*")
    emit_decl(b, "fray_map_del", "i8*", "i8*, i8*")
    emit_decl(b, "fray_map_len", "i8*", "i8*")
    emit_decl(b, "fray_map_keys", "i8*", "i8*")
    emit_decl(b, "fray_slice", "i8*", "i8*, i8*, i8*, i8*")
    emit_decl(b, "fray_some", "i8*", "i8*")
    emit_decl(b, "fray_ok", "i8*", "i8*")
    emit_decl(b, "fray_err", "i8*", "i8*")
    emit_decl(b, "fray_unwrap", "i8*", "i8*")
    emit_decl(b, "fray_is_some", "i8*", "i8*")
    emit_decl(b, "fray_is_none_val", "i8*", "i8*")
    emit_decl(b, "fray_is_ok", "i8*", "i8*")
    emit_decl(b, "fray_is_err", "i8*", "i8*")
    emit_decl(b, "fray_thread_count", "i32", "")
    emit_decl(b, "fray_thread_spawn", "i64", "i8*")
    emit_decl(b, "fray_thread_join", "void", "i64")
    emit_decl(b, "fray_thread_join_all", "void", "")
    emit_decl(b, "fray_atomic_new", "i8*", "i8*")
    emit_decl(b, "fray_atomic_get", "i8*", "i8*")
    emit_decl(b, "fray_atomic_set", "void", "i8*, i8*")
    emit_decl(b, "fray_atomic_add", "i8*", "i8*, i8*")
    emit_decl(b, "fray_channel_new", "i8*", "i8*")
    emit_decl(b, "fray_channel_send", "i8*", "i8*, i8*")
    emit_decl(b, "fray_channel_recv", "i8*", "i8*")
    emit_decl(b, "fray_channel_close_boxed", "i8*", "i8*")
    emit_decl(b, "fray_coro_start_argv", "i8*", "i8*, i8*")
    emit_decl(b, "fray_coro_await", "i8*", "i8*")
    emit_decl(b, "fray_coro_argv", "i8*", "")
    emit_decl(b, "fray_coro_result_store", "void", "i8*")
    emit_decl(b, "fray_sleep_boxed", "i8*", "i8*")
    emit_decl(b, "fray_io_read_file_boxed", "i8*", "i8*")
    emit_decl(b, "fray_io_write_file_boxed", "i8*", "i8*, i8*")
    emit_decl(b, "fray_io_read_fd_boxed", "i8*", "i8*, i8*")
    emit_decl(b, "fray_io_write_fd_boxed", "i8*", "i8*, i8*")
    emit_decl(b, "fray_io_accept_boxed", "i8*", "i8*")
    emit_decl(b, "fray_io_connect_boxed", "i8*", "i8*, i8*")
    emit_decl(b, "fray_io_listen_boxed", "i8*", "i8*")
    emit_decl(b, "fray_io_close_fd_boxed", "i8*", "i8*")
    emit_decl(b, "fray_io_port_boxed", "i8*", "i8*")
    emit_decl(b, "fray_coro_yield_boxed", "i8*", "")
    emit_decl(b, "fray_coro_count_boxed", "i8*", "")
    emit_decl(b, "fray_coro_run_until_complete_shim", "i8*", "")
    emit_decl(b, "fray_try_begin", "void", "")
    emit_decl(b, "fray_try_end", "void", "")
    emit_decl(b, "fray_exc_type", "i32*", "")
    emit_decl(b, "fray_exc_clear", "void", "")
    emit_decl(b, "fray_exc_rethrow", "void", "")
    emit_decl(b, "fray_throw", "void", "i32, i8*")

# ─── Operator mapping ───
# All single-line to avoid indent issues in fray's indentation-sensitive parser

BINOP_MAP = {"+": "fray_add", "-": "fray_sub", "*": "fray_mul", "/": "fray_div", "//": "fray_floordiv", "%": "fray_mod", "^": "fray_pow", "==": "fray_eq", "!=": "fray_neq", "<": "fray_lt", ">": "fray_gt", "<=": "fray_lte", ">=": "fray_gte", "and": "fray_and", "or": "fray_or"}

AUGOP_MAP = {"+=": "fray_add", "-=": "fray_sub", "*=": "fray_mul", "/=": "fray_div", "%=": "fray_mod", "^=": "fray_pow", "//=": "fray_floordiv"}

# ─── Error collection ───
#
# Like the lexer, parser and sema, codegen collects diagnostics instead of
# printing them (see tools/frayc_selfhosted.py for the driver that shows them).
#
# Reporting matters here more than anywhere else: emitting a call to a name the
# codegen cannot resolve produces IR that LLVM rejects with "use of undefined
# value '@chr'", which tells the reader nothing about whether the fault is in
# their program or in the compiler. Every such case is reported instead.

errors = []

def get_errors():
    return errors

def clear_errors():
    while len(errors) > 0:
        errors.depend()

def codegen_error(node, msg):
    line = 0
    col = 0
    if node != null:
        line = node_get(node, "line", 0)
        col = node_get(node, "col", 0)
    errors.append(str(line) + ":" + str(col) + ": " + msg)

# Builtins the language defines (they are all backed by runtime functions, see
# bootstrap/codegen.py) — used to tell "this exists but the codegen has no
# lowering for it yet" apart from "this name does not exist at all".

KNOWN_BUILTINS = {"print": True, "input": True, "inputStr": True, "inputInt": True, "inputFloat": True, "len": True, "min": True, "max": True, "sum": True, "abs": True, "sqrt": True, "isqrt": True, "round": True, "int": True, "float": True, "str": True, "range": True, "mean": True, "med": True, "mode": True, "mid": True, "spawn": True, "join": True, "joinAll": True, "atomic": True, "sleep": True, "channel": True, "send": True, "recv": True, "close": True, "coroCount": True, "runUntilComplete": True, "yieldNow": True, "readFileAsync": True, "writeFileAsync": True, "readAsync": True, "writeAsync": True, "tcpListen": True, "tcpAccept": True, "tcpConnect": True, "closeSocket": True, "tcpPort": True, "ord": True, "chr": True, "Some": True, "Ok": True, "Err": True, "unwrap": True, "isSome": True, "isNone": True, "isOk": True, "isErr": True}

# Values the language defines as constants (mirrors CONSTANT_MAP in the oracle).

CONSTANT_MAP = {"pi": "3.141592653589793", "e": "2.718281828459045"}

# Runtime type tags (must match the FrayTag enum in runtime/runtime.h).

TAG_STRING = 4
TAG_LIST = 5
TAG_TUPLE = 6
TAG_MAP = 12

# ─── AST helpers ───

def node_type(node):
    if node == null:
        return ""
    return node["type"]

def node_get(node, key, default_val):
    if node == null:
        return default_val
    if key in node:
        return node[key]
    return default_val

# ─── Type inference for unboxed slots ───
# A local or a parameter that every assignment in its function proves to be an
# int — or a float — can live in a raw i64 (or double) alloca instead of an
# i8* slot: nothing to allocate for the value, nothing to release on the way
# out, and the arithmetic that drives a loop becomes plain machine code. This
# is the shipping emitter's port of the bootstrap's pass (the "Unboxed local
# slots" section of bootstrap/codegen.py, driven by bootstrap/inference.py):
# the same flow-insensitive join over a small lattice of ground types, and the
# same belt-and-braces guard — every boxed->raw transition goes through the
# runtime's tag-checked fray_as_int / fray_as_float, so a value that turns out
# not to be what this pass claimed reads as the runtime's own conversion rather
# than as whatever happened to be on the stack.
#
# The join here is stricter than the bootstrap's on purpose. A name is unboxed
# only when *every* contribution to it is the same ground type, and an
# expression this pass cannot type widens the name to boxed exactly like a
# disagreement does. (The bootstrap lets an untyped contribution through as "no
# information"; here a raw slot fed a string reads as 0 through fray_as_int, so
# "I don't know" has to mean "boxed".)
#
# Everything here is advisory: a name this pass does not prove keeps the boxed
# slot and the old code path, which is every path this file had before.

TY_INT = "int"
TY_FLOAT = "float"
TY_STR = "str"
TY_LIST = "list"
TY_SET = "set"
TY_MAP = "map"
TY_BOOL = "bool"
TY_UNKNOWN = "unk"
# No information yet — the join's identity element, and what a parameter with
# no proven call site starts as. It is never a specialization target.
TY_VOID = ""

CMP_OPS = {"==": True, "!=": True, "<": True, ">": True, "<=": True, ">=": True}

LOGIC_OPS = {"and": True, "or": True, "xor": True, "xnor": True}

# An augmented assignment's binary operator: "+=" -> "+" and so on.
AUG_BASE = {"+=": "+", "-=": "-", "*=": "*", "/=": "/", "//=": "//", "%=": "%", "^=": "^"}

# Calls whose result type is known without reading a body. Every other call —
# a user function whose return type this pass has not proven, a method, a
# value called dynamically — is TY_UNKNOWN, which keeps whatever it feeds
# boxed. This table mirrors bootstrap/inference.py::_call.
FIXED_RETURNS = {"int": TY_INT, "len": TY_INT, "isqrt": TY_INT, "round": TY_INT, "inputInt": TY_INT, "float": TY_FLOAT, "sqrt": TY_FLOAT, "inputFloat": TY_FLOAT, "mean": TY_FLOAT, "med": TY_FLOAT, "str": TY_STR, "input": TY_STR, "inputStr": TY_STR, "range": TY_LIST}

struct InferCtx:
    fdefs        # name -> FUNCTION_DEF node (non-async definitions only)
    params       # name -> {param -> type}: the join over every call site
    rets         # name -> type: the join over every return in the body
    globals      # module-level variable names — shared with spawned threads
    poison       # names bound where this pass does not model the binding
    envs         # name -> {local -> type}: the slots proven for that function
    params_snap  # the params table this round reads (see infer_program)

def ty_join(a, b):
    if a == b:
        return a
    if a == TY_VOID:
        return b
    if b == TY_VOID:
        return a
    return TY_UNKNOWN

def ty_numeric(t):
    if t == TY_INT or t == TY_FLOAT or t == TY_BOOL:
        return True
    return False

def binop_ty(op, lt, rt):
    # Result type of a binary operator. Comparisons and the logical operators
    # always produce a bool; the arithmetic cases mirror the runtime's own
    # dispatch in runtime/ops.c (a float operand makes the result a float, and
    # `/` always produces a float even for two ints).
    if op in CMP_OPS or op in LOGIC_OPS:
        return TY_BOOL
    if op == "+" and lt == TY_STR and rt == TY_STR:
        return TY_STR
    if op == "+" and lt == TY_LIST and rt == TY_LIST:
        return TY_LIST
    if op == "*" and lt == TY_STR and rt == TY_INT:
        return TY_STR
    if op == "*" and lt == TY_INT and rt == TY_STR:
        return TY_STR
    if ty_numeric(lt) and ty_numeric(rt):
        if op == "/":
            return TY_FLOAT
        if lt == TY_FLOAT or rt == TY_FLOAT:
            return TY_FLOAT
        return TY_INT
    return TY_UNKNOWN

def unary_ty(op, t):
    if op == "not":
        return TY_BOOL
    if op == "-":
        if t == TY_INT or t == TY_BOOL:
            return TY_INT
        if t == TY_FLOAT:
            return TY_FLOAT
    return TY_UNKNOWN

def is_range_call(node):
    # `range(...)` — the only iterable whose element type this pass tracks.
    if node_type(node) != "CALL":
        return False
    f = node["func"]
    if node_type(f) != "IDENTIFIER":
        return False
    if f["name"] != "range":
        return False
    return True

def inf_slot(ctx, env, name, ty):
    # Fold one proven type into a name's slot.
    #
    # A poisoned name (bound by a match arm or an except clause, or dropped by
    # a `del`) is never unboxed: this pass never sees those values, so a slot
    # it also proved elsewhere would be written with the wrong machine type.
    # Neither is a module global: those live in the module's globals and are
    # shared with every spawned thread, not in this frame's allocas.
    if name in ctx.poison:
        env[name] = TY_UNKNOWN
        return
    if name in ctx.globals:
        env[name] = TY_UNKNOWN
        return
    if name in env:
        env[name] = ty_join(env[name], ty)
    else:
        env[name] = ty

def inf_call_site(ctx, name, arg_nodes, ns, env):
    # Widen a callee's parameter types with the argument types of this call.
    fn = ctx.fdefs[name]
    params = fn["params"]
    if len(arg_nodes) != len(params):
        return
    slot = ctx.params[name]
    i = 0
    while i < len(arg_nodes):
        t = inf_expr(ctx, arg_nodes[i], ns, env)
        p = params[i]
        old = TY_VOID
        if p in slot:
            old = slot[p]
        slot[p] = ty_join(old, t)
        i = i + 1

def inf_expr(ctx, node, ns, env):
    # Type of an expression in scope `ns`, whose slots are `env`. Pure with
    # respect to `env`: the only table it writes is ctx.params, and only
    # through a call site, so codegen can call this to ask what it is holding.
    if node == null:
        return TY_UNKNOWN
    nt = node_type(node)
    if nt == "INT_LITERAL":
        return TY_INT
    if nt == "FLOAT_LITERAL":
        return TY_FLOAT
    if nt == "STRING_LITERAL":
        return TY_STR
    if nt == "BOOL_LITERAL":
        return TY_BOOL
    if nt == "IDENTIFIER":
        name = node["name"]
        if name in env:
            return env[name]
        if name in CONSTANT_MAP:
            return TY_FLOAT
        return TY_UNKNOWN
    if nt == "BINARY_OP":
        lt = inf_expr(ctx, node["left"], ns, env)
        rt = inf_expr(ctx, node["right"], ns, env)
        return binop_ty(node["op"], lt, rt)
    if nt == "UNARY_OP":
        return unary_ty(node["op"], inf_expr(ctx, node["operand"], ns, env))
    if nt == "LIST_LITERAL":
        i = 0
        while i < len(node["elements"]):
            inf_expr(ctx, node["elements"][i], ns, env)
            i = i + 1
        return TY_LIST
    if nt == "SET_LITERAL":
        i = 0
        while i < len(node["elements"]):
            inf_expr(ctx, node["elements"][i], ns, env)
            i = i + 1
        return TY_SET
    if nt == "MAP_LITERAL":
        i = 0
        while i < len(node["keys"]):
            inf_expr(ctx, node["keys"][i], ns, env)
            inf_expr(ctx, node["values"][i], ns, env)
            i = i + 1
        return TY_MAP
    if nt == "INDEX_ACCESS":
        inf_expr(ctx, node["obj"], ns, env)
        inf_expr(ctx, node["index"], ns, env)
        return TY_UNKNOWN
    if nt == "SLICE":
        # A slice is the index of an INDEX_ACCESS, and carries only its own
        # three bounds (see gen_slice).
        inf_expr(ctx, node_get(node, "start", null), ns, env)
        inf_expr(ctx, node_get(node, "stop", null), ns, env)
        inf_expr(ctx, node_get(node, "step", null), ns, env)
        return TY_UNKNOWN
    if nt == "MEMBER_ACCESS":
        inf_expr(ctx, node["obj"], ns, env)
        return TY_UNKNOWN
    if nt == "AWAIT_EXPR":
        # A coroutine handle, never the awaited body's return type: boxing a
        # handle as a machine int would corrupt it.
        inf_expr(ctx, node_get(node, "value", null), ns, env)
        return TY_UNKNOWN
    if nt == "CALL":
        args = node["args"]
        i = 0
        while i < len(args):
            inf_expr(ctx, args[i], ns, env)
            i = i + 1
        callee = node["func"]
        if node_type(callee) == "IDENTIFIER":
            name = callee["name"]
            if name in ctx.fdefs:
                inf_call_site(ctx, name, args, ns, env)
                if name in ctx.rets:
                    return ctx.rets[name]
                return TY_UNKNOWN
            if name in FIXED_RETURNS:
                return FIXED_RETURNS[name]
        return TY_UNKNOWN
    return TY_UNKNOWN

def inf_stmt(ctx, node, ns, env):
    # Fold one statement into `env`; returns the type of a value the
    # statement returns (TY_VOID when it returns none), which is how a
    # function's return type is the join over its returns.
    if node == null:
        return TY_VOID
    nt = node_type(node)
    if nt == "ASSIGNMENT" or nt == "AUG_ASSIGNMENT":
        target = node["target"]
        value = inf_expr(ctx, node["value"], ns, env)
        if node_type(target) == "IDENTIFIER":
            name = target["name"]
            # Bound before the branch: a name first assigned inside an if-body
            # is local to that body, so a read after the if is a name error
            # (see ident_slot).
            op = "="
            if nt == "ASSIGNMENT":
                op = node_get(node, "op", "=")
            elif nt == "AUG_ASSIGNMENT":
                op = node["op"]
            if op == "=":
                inf_slot(ctx, env, name, value)
            else:
                cur = TY_UNKNOWN
                if name in env:
                    cur = env[name]
                base = AUG_BASE[op]
                inf_slot(ctx, env, name, binop_ty(base, cur, value))
        return TY_VOID
    if nt == "RETURN_STMT":
        v = node_get(node, "value", null)
        if v == null:
            # A bare `return` is a none, so the function's result is not
            # whatever its other returns say.
            return TY_UNKNOWN
        return inf_expr(ctx, v, ns, env)
    if nt == "EXPR_STMT":
        inf_expr(ctx, node["expr"], ns, env)
        return TY_VOID
    if nt == "IF_STMT":
        total = TY_VOID
        inf_expr(ctx, node["cond"], ns, env)
        total = ty_join(total, inf_stmts(ctx, node["body"], ns, env))
        branches = node_get(node, "elif_branches", [])
        i = 0
        while i < len(branches):
            inf_expr(ctx, branches[i]["cond"], ns, env)
            total = ty_join(total, inf_stmts(ctx, branches[i]["body"], ns, env))
            i = i + 1
        total = ty_join(total, inf_stmts(ctx, node_get(node, "else_body", null), ns, env))
        return total
    if nt == "WHILE_LOOP":
        inf_expr(ctx, node["cond"], ns, env)
        inf_stmts(ctx, node["body"], ns, env)
        return TY_VOID
    if nt == "FOR_LOOP":
        iterable = node["iterable"]
        if is_range_call(iterable):
            # fray_range3 fills the list with fray_int, so a range's elements
            # are ints whatever the bounds were.
            inf_expr(ctx, iterable, ns, env)
            inf_slot(ctx, env, node["var"], TY_INT)
        else:
            # Element types are not tracked: the loop variable stays boxed.
            inf_expr(ctx, iterable, ns, env)
            inf_slot(ctx, env, node["var"], TY_UNKNOWN)
        inf_stmts(ctx, node["body"], ns, env)
        return TY_VOID
    if nt == "TRY_STMT":
        total = inf_stmts(ctx, node["body"], ns, env)
        handlers = node_get(node, "except_clauses", [])
        i = 0
        while i < len(handlers):
            if handlers[i]["name"] != null:
                ctx.poison[handlers[i]["name"]] = True
            total = ty_join(total, inf_stmts(ctx, handlers[i]["body"], ns, env))
            i = i + 1
        total = ty_join(total, inf_stmts(ctx, node_get(node, "finally_body", null), ns, env))
        return total
    if nt == "MATCH_EXPR":
        inf_expr(ctx, node["subject"], ns, env)
        arms = node_get(node, "arms", [])
        i = 0
        while i < len(arms):
            # An arm's parameters are bound by fray_struct_field_get, so this
            # pass never sees the type they carry.
            params = node_get(arms[i], "params", [])
            j = 0
            while j < len(params):
                ctx.poison[params[j]] = True
                j = j + 1
            inf_stmts(ctx, arms[i]["body"], ns, env)
            i = i + 1
        return TY_VOID
    if nt == "DEL_STMT":
        # `del x` rebinds x to none, which a machine slot cannot hold.
        target = node["target"]
        if node_type(target) == "IDENTIFIER":
            ctx.poison[target["name"]] = True
        return TY_VOID
    return TY_VOID

def inf_stmts(ctx, stmts, ns, env):
    # A missing block is null, not an empty list: the parser writes else_body
    # and finally_body as null when the program has no else / no finally.
    if stmts == null:
        return TY_VOID
    total = TY_VOID
    i = 0
    while i < len(stmts):
        total = ty_join(total, inf_stmt(ctx, stmts[i], ns, env))
        i = i + 1
    return total

def infer_program(program, globals):
    # What each function's locals are proven to be, plus the widened parameter
    # and return types the call sites agree on.
    #
    # Three rounds, each a Jacobi step: a body is walked against the parameter
    # and return types of the *previous* round (ctx.params_snap), and what it
    # learns lands in ctx.params / ctx.rets for the next one. Reading a table
    # that the same round is still writing would let a stale, more precise
    # claim outlive the widening that disproves it. Every round only widens,
    # so a program that needs a fourth one simply keeps more slots boxed.
    ctx = InferCtx()
    ctx.globals = globals
    ctx.poison = {}
    ctx.fdefs = {}
    ctx.params = {}
    ctx.rets = {}
    ctx.envs = {}
    ctx.params_snap = {}
    i = 0
    while i < len(program["body"]):
        s = program["body"][i]
        # An async function's arguments travel through the coroutine's
        # argument list and its call yields a handle, so neither its
        # parameters nor its return type can be reasoned about here.
        if node_type(s) == "FUNCTION_DEF" and not node_get(s, "is_async", False):
            ctx.fdefs[s["name"]] = s
        i = i + 1
    for name in ctx.fdefs:
        fn = ctx.fdefs[name]
        seeded = {}
        j = 0
        while j < len(fn["params"]):
            seeded[fn["params"][j]] = TY_VOID
            j = j + 1
        ctx.params[name] = seeded
        ctx.rets[name] = TY_UNKNOWN
    rnd = 0
    while rnd < 3:
        for name in ctx.fdefs:
            snap = {}
            for p in ctx.params[name]:
                snap[p] = ctx.params[name][p]
            ctx.params_snap[name] = snap
        # The module scope has no slots to prove (its variables are globals),
        # but the calls it makes are call sites like any other.
        i = 0
        while i < len(program["body"]):
            s = program["body"][i]
            if node_type(s) != "FUNCTION_DEF":
                inf_stmt(ctx, s, "", {})
            i = i + 1
        for name in ctx.fdefs:
            fn = ctx.fdefs[name]
            snap = ctx.params_snap[name]
            env = {}
            j = 0
            while j < len(fn["params"]):
                p = fn["params"][j]
                t = snap[p]
                if t == TY_VOID:
                    # Nothing proved this parameter's type, so every slot it
                    # reaches — including itself — stays boxed.
                    t = TY_UNKNOWN
                env[p] = t
                j = j + 1
            ctx.rets[name] = inf_stmts(ctx, fn["body"], name, env)
            ctx.envs[name] = env
        rnd = rnd + 1
    return ctx

# ─── String constant encoding ───

def encode_string(s):
    # One entry per BYTE: the IR holds a literal in an [N x i8] constant, so
    # this must yield the string's bytes.
    #
    # The two engines hand us different string models. The compiled runtime's
    # strings ARE byte strings, so a source literal arrives as its raw bytes and
    # every character is < 256 — already a byte, pass it through. The oracle
    # decodes the file into code points, so a 3-byte em dash arrives as the
    # single character 0x2014 — encode it as UTF-8. Writing ord(s[i]) straight
    # into the i8 slot truncated the em dash to 0x14 in the oracle's IR (and
    # every diagnostic in this compiler contains one); re-encoding blindly in
    # the compiled engine, whose characters are already bytes, doubled them.
    result = []
    i = 0
    while i < len(s):
        code = ord(s[i])
        if code < 256:
            result.append(str(code))
        elif code < 2048:
            result.append(str(192 + code // 64))
            result.append(str(128 + code % 64))
        elif code < 65536:
            result.append(str(224 + code // 4096))
            result.append(str(128 + (code // 64) % 64))
            result.append(str(128 + code % 64))
        else:
            result.append(str(240 + code // 262144))
            result.append(str(128 + (code // 4096) % 64))
            result.append(str(128 + (code // 64) % 64))
            result.append(str(128 + code % 64))
        i = i + 1
    result.append("0")
    return result

def string_const_ref(b, s):
    idx = get_string_const(b, s)
    encoded = encode_string(s)
    while len(b.string_encoded) < len(b.string_consts):
        b.string_encoded.append(null)
    b.string_encoded[idx - 1] = encoded
    slen = len(encoded)
    return "bitcast [" + str(slen) + " x i8]* @.str." + str(idx) + " to i8*"

# ─── Expression codegen ───
# Returns the SSA variable name holding the i8* result

def gen_builtin_unary(b, rt_name, args):
    # One-argument builtin: the runtime borrows the argument (the caller keeps
    # ownership) and returns an owned result.
    v = fresh_var(b)
    emit(b, "  " + v + " = call i8* @\"" + rt_name + "\"(i8* " + args[0] + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
    return v

def gen_value_wrapper(b, node):
    # `void @"fray_val.<name>"(i8* %self_fn)` — the body a first-class function
    # object runs when the runtime's fray_call invokes it. The arguments arrive
    # as a list (fray_call_args) and the result leaves through
    # fray_call_result_store; the shape is the one the thread and coroutine
    # entry points use, so the runtime invokes all three identically. A named
    # function without this wrapper is not callable as a value at all.
    #
    # Numbering restarts per function and starts at 0: LLVM's own tools (llc)
    # enforce that the first unnamed temporary of every function is `%0` and
    # that the numbers only grow from there. llvmlite's parser tolerated a
    # module whose first temporary was `%1`; `llc` rejected it with
    # "instruction expected to be numbered '%0'".
    saved_counter = b.var_counter
    b.var_counter = -1
    name = node["name"]
    params = node["params"]
    emit(b, "define void @\"fray_val." + name + "\"(i8* %self_fn)")
    emit(b, "{")
    block = fresh_block(b, "entry_val")
    emit(b, block + ":")
    argv = ""
    if len(params) > 0:
        argv = fresh_var(b)
        emit(b, "  " + argv + " = call i8* @\"fray_call_args\"()")
    arg_str = ""
    i = 0
    while i < len(params):
        # fray_list_index hands back an owned reference and the callee owns its
        # parameters, so each one below takes this reference over and drops it
        # on its own return path. (The wrapper released them here itself when
        # parameters were borrowed.) The argument list keeps the values alive
        # for the call either way.
        elem = fresh_var(b)
        emit(b, "  " + elem + " = call i8* @\"fray_list_index\"(i8* " + argv + ", i64 " + str(i) + ")")
        if i > 0:
            arg_str = arg_str + ", "
        arg_str = arg_str + "i8* " + elem
        i = i + 1
    result = fresh_var(b)
    emit(b, "  " + result + " = call i8* @\"" + name + "\"(" + arg_str + ")")
    # fray_call_result_store takes ownership of the result, so it must not be
    # released here. The argument references are not released either: the
    # callee owns its parameters, so the reference fray_list_index produced
    # above for each one is dropped on the callee's own return path. The
    # argument list holds a reference of its own for the call's lifetime.
    emit(b, "  call void @\"fray_call_result_store\"(i8* " + result + ")")
    emit(b, "  ret void")
    emit(b, "}")
    emit(b, "")
    b.var_counter = saved_counter

def gen_function_value(b, name):
    # A bare function name in value position: a function object wrapping the
    # wrapper body above, so a call site that cannot resolve its callee
    # statically reaches it through fray_call.
    # Numbered temporaries must appear in the order they are numbered: LLVM
    # rejects a module whose names are not increasing inside a function.
    name_str = fresh_var(b)
    ref = string_const_ref(b, name)
    emit(b, "  " + name_str + " = " + ref)
    wrapper = fresh_var(b)
    emit(b, "  " + wrapper + " = bitcast void (i8*)* @\"fray_val." + name + "\" to i8*")
    v = fresh_var(b)
    emit(b, "  " + v + " = call i8* @\"fray_function\"(i8* " + name_str + ", i8* " + wrapper + ", i32 " + str(b.func_arities[name]) + ")")
    return v

def gen_call_with_args(b, fn_val, args):
    # Call an evaluated callee value with already-evaluated arguments. The
    # argument list is what the runtime's fray_call carries them in; it takes a
    # reference to each, so the argument this call owns is released after the
    # append. The callee is borrowed here — its owner releases it.
    argv = fresh_var(b)
    emit(b, "  " + argv + " = call i8* @\"fray_list\"()")
    i = 0
    while i < len(args):
        emit(b, "  call void @\"fray_list_append\"(i8* " + argv + ", i8* " + args[i] + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + args[i] + ")")
        i = i + 1
    v = fresh_var(b)
    emit(b, "  " + v + " = call i8* @\"fray_call\"(i8* " + fn_val + ", i8* " + argv + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + argv + ")")
    return v

def gen_value_call(b, callee, arg_nodes):
    # Call a value that is not a statically known function, with the callee and
    # the arguments as expressions: a parameter, a variable, a struct field, a
    # list element. The runtime decides whether the value is callable and
    # whether the count matches — its TypeErrors are the oracle's, and this is
    # the only place they can be raised, because the callee is not known until
    # the program runs.
    fn_val = gen_expr(b, callee)
    args = []
    i = 0
    while i < len(arg_nodes):
        args.append(gen_expr(b, arg_nodes[i]))
        i = i + 1
    v = gen_call_with_args(b, fn_val, args)
    emit(b, "  call void @\"fray_release\"(i8* " + fn_val + ")")
    return v

def input_rt_suffix(fn_name):
    # The runtime name each documented input builtin reads through.
    # `input` and `inputStr` are the same reader (inputStr is the spelling
    # fray.txt uses), and inputInt/inputFloat have their own conversions.
    if fn_name == "inputInt":
        return "input_int"
    if fn_name == "inputFloat":
        return "input_float"
    return "input"


def gen_builtin_nullary(b, rt_name):
    # Zero-argument builtin: the runtime returns an owned result.
    v = fresh_var(b)
    emit(b, "  " + v + " = call i8* @\"" + rt_name + "\"()")
    return v

def gen_none(b):
    # A fresh none value, owned by the caller (the print case's idiom).
    v = fresh_var(b)
    emit(b, "  " + v + " = call i8* @\"fray_none\"()")
    return v

def gen_builtin_chain(b, rt_name, args):
    # min()/max() are variadic: fold pairwise. The runtime returns an owned
    # alias of one operand, so every input can be released after each call
    # (mirrors the oracle's handling).
    result = args[0]
    i = 1
    while i < len(args):
        nxt = fresh_var(b)
        emit(b, "  " + nxt + " = call i8* @\"" + rt_name + "\"(i8* " + result + ", i8* " + args[i] + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + result + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + args[i] + ")")
        result = nxt
        i = i + 1
    return result

# obj[start:stop:step] — a missing bound is evaluated to none, which the runtime
# reads as "from the start" / "to the end" / "step 1" (see runtime/ops.c).

def gen_slice(b, node):
    obj = gen_expr(b, node["obj"])
    sl = node["index"]
    start = gen_expr(b, sl["start"])
    stop = gen_expr(b, sl["stop"])
    step = gen_expr(b, sl["step"])
    v = fresh_var(b)
    emit(b, "  " + v + " = call i8* @\"fray_slice\"(i8* " + obj + ", i8* " + start + ", i8* " + stop + ", i8* " + step + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + step + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + stop + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + start + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + obj + ")")
    return v

def gen_boxed_int(b, n):
    # A boxed integer constant, for builtins that take an optional bound the
    # source did not spell out (range's default step).
    v = fresh_var(b)
    emit(b, "  " + v + " = call i8* @\"fray_int\"(i64 " + n + ")")
    return v

def gen_expr(b, node):
    if node == null:
        # Emit a real instruction rather than returning an inline call
        # expression: the result is used as an SSA operand, and an operand
        # cannot be a call.
        v = fresh_var(b)
        emit(b, "  " + v + " = call i8* @\"fray_none\"()")
        return v
    nt = node_type(node)
    if nt == "INT_LITERAL":
        v = fresh_var(b)
        val = node["value"]
        emit(b, "  " + v + " = call i8* @\"fray_int\"(i64 " + val + ")")
        return v
    if nt == "FLOAT_LITERAL":
        v = fresh_var(b)
        val = node["value"]
        emit(b, "  " + v + " = call i8* @\"fray_float\"(double " + val + ")")
        return v
    if nt == "STRING_LITERAL":
        v = fresh_var(b)
        val = node["value"]
        ref = string_const_ref(b, val)
        emit(b, "  " + v + " = " + ref)
        v2 = fresh_var(b)
        emit(b, "  " + v2 + " = call i8* @\"fray_string_copy\"(i8* " + v + ")")
        return v2
    if nt == "BOOL_LITERAL":
        v = fresh_var(b)
        val = "0"
        if node["value"] == "True":
            val = "1"
        emit(b, "  " + v + " = call i8* @\"fray_bool\"(i1 " + val + ")")
        return v
    if nt == "NONE_LITERAL":
        return gen_none(b)
    if nt == "AWAIT_EXPR":
        # await expr — suspends the running coroutine until the target
        # completes and yields its result (runtime/coroutine.c). Only an
        # async body may suspend; the check is the bootstrap emitter's.
        if b.in_async == 0:
            codegen_error(node, "await outside an async function")
            return gen_none(b)
        operand = node_get(node, "value", null)
        if operand == null:
            return gen_none(b)
        target = gen_expr(b, operand)
        v = fresh_var(b)
        emit(b, "  " + v + " = call i8* @\"fray_coro_await\"(i8* " + target + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + target + ")")
        return v
    if nt == "IDENTIFIER":
        name = node["name"]
        if name in b.raw_vars:
            # A machine slot: box the value for the boxed world, which is a
            # fresh int/float box and no reference counting at all.
            return box_raw(b, load_raw(b, name), b.slot_kinds[name])
        if not (name in b.func_vars) and not (name in b.global_vars):
            # The numeric constants are module-level builtins, not keywords
            # (spec/semantics.md §12): a local, parameter, loop variable or
            # module global with the same name shadows them. Resolving them
            # first made `e` Euler's number inside every function that also
            # bound it — invisible in the compiler's own source, which uses
            # `for e in enum_defs:`.
            if name in CONSTANT_MAP:
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_float\"(double " + CONSTANT_MAP[name] + ")")
                return v
            if name in b.enum_defs:
                # A bare enum name still parses as the head of a variant
                # reference: the parser folds '.Variant' into a MEMBER_ACCESS
                # around this IDENTIFIER, so the whole construct is handled
                # there and reaching this branch means the enum name appeared
                # alone in value position (the oracle accepts it silently).
                codegen_error(node, "enum '" + name + "' is a type, not a value — reference a variant as '" + name + ".Variant'")
            elif name in b.struct_defs:
                codegen_error(node, "struct '" + name + "' is a type, not a value")
            elif name in b.func_names:
                # A function used as a value (stored, passed, called through a
                # variable) is a function object, not the module slot of the
                # same name. An async function has no such wrapper: its only
                # entry point is the coroutine trampoline, and calling it
                # through a value would run the body without a coroutine
                # behind it. Reject instead of emitting a call that fails at
                # run time.
                if name in b.async_fns:
                    codegen_error(node, "async function '" + name + "' used as a value is not supported by the self-hosted codegen yet")
                    return gen_none(b)
                return gen_function_value(b, name)
            elif name in b.modules:
                codegen_error(node, "module '" + name + "' is not supported by the self-hosted codegen yet")
            else:
                codegen_error(node, "unknown name '" + name + "'")
        v = fresh_var(b)
        if name in b.func_vars:
            emit(b, "  " + v + " = load i8*, i8** " + b.func_vars[name])
            emit(b, "  call void @\"fray_retain\"(i8* " + v + ")")
        else:
            emit(b, "  " + v + " = load i8*, i8** @\"" + name + "\"")
            emit(b, "  call void @\"fray_retain\"(i8* " + v + ")")
        return v
    if nt == "BINARY_OP":
        op = node["op"]
        if op == "+" or op == "-" or op == "*" or op == "/" or op == "//" or op == "%" or op == "^":
            # Proven int/int arithmetic becomes machine arithmetic with one
            # box for the result, and float arithmetic likewise (see
            # "Unboxed slots").
            if raw_int_ready(b, node):
                return box_raw(b, raw_int_binop(b, node), TY_INT)
            if raw_float_ready(b, node):
                return box_raw(b, raw_float_binop(b, node), TY_FLOAT)
            lv = gen_expr(b, node["left"])
            rv = gen_expr(b, node["right"])
            fn = "fray_add"
            if op in BINOP_MAP:
                fn = BINOP_MAP[op]
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"" + fn + "\"(i8* " + lv + ", i8* " + rv + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + lv + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + rv + ")")
            return v
        if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=":
            # A comparison of two proven numbers is an icmp (or fcmp) and one
            # bool box, not two operand boxes and a call into the runtime.
            if raw_cmp_ready(expr_ty(b, node["left"])) and raw_cmp_ready(expr_ty(b, node["right"])):
                ck = cmp_kind(expr_ty(b, node["left"]), expr_ty(b, node["right"]))
                l = unbox_as(b, node["left"], ck)
                r = unbox_as(b, node["right"], ck)
                res = raw_cmp(b, op, ck, l, r)
                bv = fresh_var(b)
                emit(b, "  " + bv + " = call i8* @\"fray_bool\"(i1 " + res + ")")
                return bv
            lv = gen_expr(b, node["left"])
            rv = gen_expr(b, node["right"])
            fn = BINOP_MAP[op]
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"" + fn + "\"(i8* " + lv + ", i8* " + rv + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + lv + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + rv + ")")
            return v
        if op == "and" or op == "or":
            lv = gen_expr(b, node["left"])
            # Short-circuit: keep lv as the result if it decides the answer, and
            # only then evaluate the right side. The phi that merges the two
            # paths needs the block the branch is taken from to be a block of
            # its own, so open one for the test.
            test_block = fresh_block(b, op + "_test")
            if len(b.lines) > 0 and not is_terminated(b):
                emit(b, "  br label %" + test_block)
            emit(b, test_block + ":")
            truthy = fresh_var(b)
            emit(b, "  " + truthy + " = call i1 @\"fray_is_truthy\"(i8* " + lv + ")")
            rhs_block = fresh_block(b, op + "_rhs")
            done_block = fresh_block(b, op + "_done")
            if op == "and":
                emit(b, "  br i1 " + truthy + ", label %" + rhs_block + ", label %" + done_block)
            else:
                emit(b, "  br i1 " + truthy + ", label %" + done_block + ", label %" + rhs_block)
            emit(b, rhs_block + ":")
            emit(b, "  call void @\"fray_release\"(i8* " + lv + ")")
            rv = gen_expr(b, node["right"])
            # The right side may have created blocks of its own, so the phi cannot
            # name rhs_block: join from a fresh block that the right side falls
            # into. (Naming a block that is not a predecessor is what LLVM rejects
            # with "PHI node entries do not match predecessors".)
            rhs_done = fresh_block(b, op + "_rhsdone")
            if not is_terminated(b):
                emit(b, "  br label %" + rhs_done)
            emit(b, rhs_done + ":")
            emit(b, "  br label %" + done_block)
            emit(b, done_block + ":")
            v = fresh_var(b)
            emit(b, "  " + v + " = phi i8* [" + lv + ", %" + test_block + "], [" + rv + ", %" + rhs_done + "]")
            return v
        if op == "xor" or op == "xnor":
            # Both sides are always evaluated (no short-circuit), matching the oracle.
            lv = gen_expr(b, node["left"])
            rv = gen_expr(b, node["right"])
            fn = "fray_xor"
            if op == "xnor":
                fn = "fray_xnor"
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"" + fn + "\"(i8* " + lv + ", i8* " + rv + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + lv + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + rv + ")")
            return v
        if op == "in":
            lv = gen_expr(b, node["left"])
            rv = gen_expr(b, node["right"])
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_contains\"(i8* " + rv + ", i8* " + lv + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + lv + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + rv + ")")
            return v
        lv = gen_expr(b, node["left"])
        rv = gen_expr(b, node["right"])
        v = fresh_var(b)
        emit(b, "  " + v + " = call i8* @\"fray_add\"(i8* " + lv + ", i8* " + rv + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + lv + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + rv + ")")
        return v
    if nt == "UNARY_OP":
        op = node["op"]
        if op == "-":
            if expr_ty(b, node) == TY_INT:
                i = unbox_int(b, node["operand"])
                r = fresh_var(b)
                emit(b, "  " + r + " = sub i64 0, " + i)
                return box_raw(b, r, TY_INT)
            if expr_ty(b, node) == TY_FLOAT:
                f = unbox_float(b, node["operand"])
                r = fresh_var(b)
                emit(b, "  " + r + " = fneg double " + f)
                return box_raw(b, r, TY_FLOAT)
            val = gen_expr(b, node["operand"])
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_neg\"(i8* " + val + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + val + ")")
            return v
        if op == "not":
            val = gen_expr(b, node["operand"])
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_not\"(i8* " + val + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + val + ")")
            return v
        if op == "?":
            # Postfix `?` on an Option/Result: the runtime unwraps it (and
            # raises on None/Err, which both compiled engines and the oracle
            # treat the same way).
            val = gen_expr(b, node["operand"])
            return gen_builtin_unary(b, "fray_unwrap", [val])
    if nt == "CALL":
        fn = node["func"]
        fn_name = ""
        if node_type(fn) == "IDENTIFIER":
            fn_name = fn["name"]
        if node_type(fn) != "IDENTIFIER" and node_type(fn) != "MEMBER_ACCESS":
            # A callee expression rather than a name: `fs[0](6, 7)`, a call
            # result, a parenthesized value. Only the runtime can tell whether
            # it is callable.
            return gen_value_call(b, fn, node["args"])
        if node_type(fn) == "MEMBER_ACCESS":
            method = fn["attr"]
            # Enum variant construction via Color.Green(...): check enum
            # membership BEFORE evaluating the object (the enum name is not
            # a runtime value).
            if node_type(fn["obj"]) == "IDENTIFIER" and fn["obj"]["name"] in b.enum_defs:
                ename = fn["obj"]["name"]
                einfo = b.enum_defs[ename]
                j = 0
                while j < len(einfo["cases"]):
                    if einfo["cases"][j]["name"] == method:
                        # A parameterless variant is not callable: `Color.Red()`
                        # compiled here and built a value whose every field was
                        # null — the oracle rejects the call with
                        # "'Color.Red' is not callable". Refuse it instead of
                        # emitting a program the reference never accepts. The
                        # value itself is written `Color.Red` with no parens
                        # and is compiled by the MEMBER_ACCESS branch above.
                        if len(einfo["cases"][j]["params"]) == 0:
                            codegen_error(node, "'" + ename + "." + method + "' is not callable — the variant has no parameters; write the value as '" + ename + "." + method + "' without parentheses")
                            none_val = fresh_var(b)
                            emit(b, "  " + none_val + " = call i8* @\"fray_none\"()")
                            return none_val
                        # An arity mismatch lowered to fray_struct_new, which
                        # binds positionally: too few arguments left the rest of
                        # the fields null and too many were dropped, where the
                        # oracle raises "Color.Green() takes 3 argument(s) (1
                        # given)" and the bootstrap engine dies at run time.
                        # Reject at compile time like the oracle.
                        vparams = einfo["cases"][j]["params"]
                        if len(node["args"]) != len(vparams):
                            codegen_error(node, "'" + ename + "." + method + "()' takes " + str(len(vparams)) + " argument(s) (" + str(len(node["args"])) + " given)")
                            none_val = fresh_var(b)
                            emit(b, "  " + none_val + " = call i8* @\"fray_none\"()")
                            return none_val
                        args = []
                        ai = 0
                        while ai < len(node["args"]):
                            args.append(gen_expr(b, node["args"][ai]))
                            ai = ai + 1
                        return gen_enum_new(b, ename, einfo, method, args)
                    j = j + 1
            obj_val = gen_expr(b, fn["obj"])
            args = []
            i = 0
            while i < len(node["args"]):
                args.append(gen_expr(b, node["args"][i]))
                i = i + 1
            if method == "upper" or method == "lower" or method == "trim":
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_string_" + method + "\"(i8* " + obj_val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
                return v
            if method == "find":
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_string_find\"(i8* " + obj_val + ", i8* " + args[0] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
                return v
            if method == "replace":
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_string_replace\"(i8* " + obj_val + ", i8* " + args[0] + ", i8* " + args[1] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + args[1] + ")")
                return v
            if method == "split":
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_string_split\"(i8* " + obj_val + ", i8* " + args[0] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
                return v
            if method == "startswith":
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_string_startswith\"(i8* " + obj_val + ", i8* " + args[0] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
                return v
            if method == "endswith":
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_string_endswith\"(i8* " + obj_val + ", i8* " + args[0] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
                return v
            if method == "append":
                if len(args) > 0:
                    # fray_append, not fray_list_append: `.append` is documented
                    # for sets as well (fray.txt's "#random:" group), and the
                    # tag that decides which one this is only exists at run
                    # time.
                    emit(b, "  call void @\"fray_append\"(i8* " + obj_val + ", i8* " + args[0] + ")")
                    # fray_append *retains* the element, like the two it
                    # dispatches to: the container owns its own reference, and
                    # the one this call holds is dropped here. (fray_map_set and
                    # struct_field_set are the other convention — they take
                    # ownership — so they get no release.)
                    emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_none\"()")
                return v
            if method == "depend":
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_depend\"(i8* " + obj_val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
                return v
            if method == "keys":
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_map_keys\"(i8* " + obj_val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
                return v
            if method == "has":
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_map_has\"(i8* " + obj_val + ", i8* " + args[0] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
                return v
            # Atomic methods: a.get() / a.set(v) / a.add(v). The runtime
            # validates that the object is an atomic and raises TypeError
            # otherwise, which is what the oracle does.
            if method == "get" and len(args) == 0:
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_atomic_get\"(i8* " + obj_val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
                return v
            if method == "set" and len(args) == 1:
                emit(b, "  call void @\"fray_atomic_set\"(i8* " + obj_val + ", i8* " + args[0] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
                return gen_none(b)
            if method == "add" and len(args) == 1:
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_atomic_add\"(i8* " + obj_val + ", i8* " + args[0] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
                return v
            # A member that is no known method: read the field and call the
            # value it holds (`h.fn(2, 3)`), which is the dynamic call path —
            # the callee is not known until the program runs. This used to
            # return the field itself and drop the call, so the field's value
            # was never invoked.
            field_str = fresh_var(b)
            ref = string_const_ref(b, method)
            emit(b, "  " + field_str + " = " + ref)
            callee_val = fresh_var(b)
            emit(b, "  " + callee_val + " = call i8* @\"fray_struct_field_get\"(i8* " + obj_val + ", i8* " + field_str + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + obj_val + ")")
            v = gen_call_with_args(b, callee_val, args)
            emit(b, "  call void @\"fray_release\"(i8* " + callee_val + ")")
            return v
        args = []
        i = 0
        while i < len(node["args"]):
            args.append(gen_expr(b, node["args"][i]))
            i = i + 1
        # Async call (Phase 7): the callee's entry point is the coroutine
        # trampoline, and the arguments travel with the coroutine as a list, so
        # the body can unpack its parameters without the runtime knowing the
        # arity. The call returns the coroutine handle immediately; `await` on
        # it (or runUntilComplete) drives it to completion.
        if fn_name in b.async_fns:
            arity = b.func_arities[fn_name]
            if arity != len(args):
                codegen_error(node, "async function '" + fn_name + "' takes " + str(arity) + " argument(s) (" + str(len(args)) + " given)")
                return gen_none(b)
            argv = fresh_var(b)
            emit(b, "  " + argv + " = call i8* @\"fray_list\"()")
            i = 0
            while i < len(args):
                emit(b, "  call void @\"fray_list_append\"(i8* " + argv + ", i8* " + args[i] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + args[i] + ")")
                i = i + 1
            cname = fresh_var(b)
            cref = string_const_ref(b, fn_name)
            emit(b, "  " + cname + " = " + cref)
            ctramp = fresh_var(b)
            emit(b, "  " + ctramp + " = bitcast void (i8*)* @\"fray_async." + fn_name + "\" to i8*")
            cfn = fresh_var(b)
            emit(b, "  " + cfn + " = call i8* @\"fray_function\"(i8* " + cname + ", i8* " + ctramp + ", i32 " + str(len(args)) + ")")
            handle = fresh_var(b)
            emit(b, "  " + handle + " = call i8* @\"fray_coro_start_argv\"(i8* " + cfn + ", i8* " + argv + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + cfn + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + argv + ")")
            return handle
        # Enum variant direct call: Green(255, 0, 128)
        ev_enum = find_enum_variant(b.enum_defs, fn_name)
        if ev_enum[0] != null:
            ev_ename = ev_enum[0]
            ev_vinfo = ev_enum[1]
            ev_vname = ev_vinfo["name"]
            return gen_enum_new(b, ev_ename, b.enum_defs[ev_ename], ev_vname, args)
        if fn_name in b.struct_defs:
            field_names = b.struct_defs[fn_name]
            name_str = fresh_var(b)
            ref = string_const_ref(b, fn_name)
            emit(b, "  " + name_str + " = " + ref)
            name_copy = fresh_var(b)
            emit(b, "  " + name_copy + " = call i8* @\"fray_string_copy\"(i8* " + name_str + ")")
            fields_list = fresh_var(b)
            emit(b, "  " + fields_list + " = call i8* @\"fray_list\"()")
            fi = 0
            while fi < len(field_names):
                fn_str = fresh_var(b)
                fn_ref = string_const_ref(b, field_names[fi])
                emit(b, "  " + fn_str + " = " + fn_ref)
                fn_copy = fresh_var(b)
                emit(b, "  " + fn_copy + " = call i8* @\"fray_string_copy\"(i8* " + fn_str + ")")
                emit(b, "  call void @\"fray_list_append\"(i8* " + fields_list + ", i8* " + fn_copy + ")")
                # append retains — this call's reference goes back now (the
                # field-name copies used to leak one box each).
                emit(b, "  call void @\"fray_release\"(i8* " + fn_copy + ")")
                fi = fi + 1
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_struct_new_boxed\"(i8* " + name_copy + ", i8* " + fields_list + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + fields_list + ")")
            # fray_struct_new_boxed ignores the name value (the struct carries
            # no per-instance type name; module identity is the field set, and
            # an enum records its own name in `_enum`), so it neither keeps the
            # reference nor drops it: the caller's copy is released here.
            emit(b, "  call void @\"fray_release\"(i8* " + name_copy + ")")
            ai = 0
            while ai < len(args) and ai < len(field_names):
                fs = fresh_var(b)
                fs_ref = string_const_ref(b, field_names[ai])
                emit(b, "  " + fs + " = " + fs_ref)
                emit(b, "  call void @\"fray_struct_field_set\"(i8* " + v + ", i8* " + fs + ", i8* " + args[ai] + ")")
                ai = ai + 1
            return v
        if fn_name == "print":
            # print() is variadic: every argument but the last is written with
            # a trailing space and the last one closes the line, so print(x)
            # stays the single fray_print call it has always been. print()
            # with no arguments is a bare newline — what the oracle does, and
            # what bootstrap/evaluator.py's _builtin_print already did.
            pidx = 0
            while pidx < len(args) - 1:
                emit(b, "  call void @\"fray_print_sep\"(i8* " + args[pidx] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + args[pidx] + ")")
                pidx = pidx + 1
            if len(args) > 0:
                plast = args[len(args) - 1]
                emit(b, "  call void @\"fray_print\"(i8* " + plast + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + plast + ")")
            else:
                emit(b, "  call void @\"fray_print_end\"()")
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_none\"()")
            emit(b, "  call void @\"fray_release\"(i8* " + v + ")")
            return v
        if fn_name == "input" or fn_name == "inputStr" or fn_name == "inputInt" or fn_name == "inputFloat":
            # Read a line from stdin. The prompt form goes to the runtime's
            # `_str` entry point, which writes the prompt and then reads: the
            # oracle accepts a prompt on all four, and fray.txt's example uses
            # it. fray.txt documents these and the runtime has always had
            # them — no emitter lowered the calls, so every documented input
            # form was a codegen error.
            if len(args) > 1:
                codegen_error(node, fn_name + "() takes at most 1 argument(s) (" + str(len(args)) + " given)")
                return gen_none(b)
            if len(args) == 0:
                return gen_builtin_nullary(b, "fray_" + input_rt_suffix(fn_name))
            raw = fresh_var(b)
            emit(b, "  " + raw + " = call i8* @\"fray_as_string\"(i8* " + args[0] + ")")
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_" + input_rt_suffix(fn_name) + "_str\"(i8* " + raw + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            return v
        if fn_name == "len" and len(args) > 0:
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_len\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            return v
        if fn_name == "abs" and len(args) > 0:
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_abs\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            return v
        if fn_name == "str" and len(args) > 0:
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_str_val\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            return v
        if fn_name == "int" and len(args) > 0:
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_int_val\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            return v
        if fn_name == "float" and len(args) > 0:
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_float_val\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            return v
        if fn_name == "range" and len(args) > 0:
            # range(stop) is the unary runtime entry point; range(start, stop)
            # and range(start, stop, step) go to fray_range3. Passing only
            # args[0] to fray_range silently ignored the other bounds (and
            # leaked their boxes), so `for i in range(1, 6)` ran range(1).
            if len(args) > 3:
                codegen_error(node, "range() takes at most 3 argument(s) (" + str(len(args)) + " given)")
                return gen_none(b)
            v = ""
            if len(args) == 1:
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_range\"(i8* " + args[0] + ")")
            else:
                step = ""
                if len(args) > 2:
                    step = args[2]
                else:
                    # The default step is a fresh box, and its number has to
                    # be allocated before v's: llc's strict mode wants the
                    # instruction numbers in emission order.
                    step = gen_boxed_int(b, "1")
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_range3\"(i8* " + args[0] + ", i8* " + args[1] + ", i8* " + step + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + args[1] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + step + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            return v
        if fn_name == "sqrt" and len(args) > 0:
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_sqrt\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            return v
        if fn_name == "progName" and len(args) == 0:
            return gen_builtin_nullary(b, "fray_prog_name")
        if fn_name == "programArgs" and len(args) == 0:
            return gen_builtin_nullary(b, "fray_argv")
        if fn_name == "fileRead" and len(args) == 1:
            return gen_builtin_unary(b, "fray_file_read", args)
        if fn_name == "fileExists" and len(args) == 1:
            return gen_builtin_unary(b, "fray_file_exists", args)
        if fn_name == "listDir" and len(args) == 1:
            return gen_builtin_unary(b, "fray_list_dir", args)
        if fn_name == "isDir" and len(args) == 1:
            return gen_builtin_unary(b, "fray_is_dir", args)
        if fn_name == "fileWrite" and len(args) == 2:
            v = fresh_var(b)
            emit(b, "  call void @\"fray_file_write\"(i8* " + args[0] + ", i8* " + args[1] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[1] + ")")
            return gen_none(b)
        if fn_name == "exit":
            if len(args) == 1:
                emit(b, "  call void @\"fray_exit_val\"(i8* " + args[0] + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            else:
                z = gen_none(b)
                emit(b, "  call void @\"fray_exit_val\"(i8* " + z + ")")
            return gen_none(b)
        # Coroutines and channels (Phase 7). The boxed shims adapt the
        # runtime's void/int entry points to the boxed calling convention,
        # exactly as the bootstrap emitter's builtin table does.
        if fn_name == "sleep" and len(args) == 1:
            return gen_builtin_unary(b, "fray_sleep_boxed", args)
        if fn_name == "yieldNow" and len(args) == 0:
            return gen_builtin_nullary(b, "fray_coro_yield_boxed")
        if fn_name == "coroCount" and len(args) == 0:
            return gen_builtin_nullary(b, "fray_coro_count_boxed")
        if fn_name == "runUntilComplete" and len(args) == 0:
            return gen_builtin_nullary(b, "fray_coro_run_until_complete_shim")
        if fn_name == "channel":
            # channel() is unbuffered and channel(n) buffered: the runtime reads
            # a non-integer capacity as zero, so the no-argument form passes
            # none (the oracle's "unbuffered" default).
            if len(args) == 0:
                cap = gen_none(b)
                v = fresh_var(b)
                emit(b, "  " + v + " = call i8* @\"fray_channel_new\"(i8* " + cap + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + cap + ")")
                return v
            return gen_builtin_unary(b, "fray_channel_new", args)
        if fn_name == "send" and len(args) == 2:
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_channel_send\"(i8* " + args[0] + ", i8* " + args[1] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[1] + ")")
            return v
        if fn_name == "recv" and len(args) == 1:
            return gen_builtin_unary(b, "fray_channel_recv", args)
        if fn_name == "close" and len(args) == 1:
            return gen_builtin_unary(b, "fray_channel_close_boxed", args)
        # Non-blocking file and socket I/O. The runtime entry points already
        # take boxed arguments, so these lower to a direct call plus the
        # release of each argument, exactly as `send` does above.
        if fn_name == "readFileAsync" and len(args) == 1:
            return gen_builtin_unary(b, "fray_io_read_file_boxed", args)
        if fn_name == "tcpListen" and len(args) == 1:
            return gen_builtin_unary(b, "fray_io_listen_boxed", args)
        if fn_name == "tcpAccept" and len(args) == 1:
            return gen_builtin_unary(b, "fray_io_accept_boxed", args)
        if fn_name == "closeSocket" and len(args) == 1:
            return gen_builtin_unary(b, "fray_io_close_fd_boxed", args)
        if fn_name == "tcpPort" and len(args) == 1:
            return gen_builtin_unary(b, "fray_io_port_boxed", args)
        if fn_name == "writeFileAsync" and len(args) == 2:
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_io_write_file_boxed\"(i8* " + args[0] + ", i8* " + args[1] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[1] + ")")
            return v
        if fn_name == "readAsync" and len(args) == 2:
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_io_read_fd_boxed\"(i8* " + args[0] + ", i8* " + args[1] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[1] + ")")
            return v
        if fn_name == "writeAsync" and len(args) == 2:
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_io_write_fd_boxed\"(i8* " + args[0] + ", i8* " + args[1] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[1] + ")")
            return v
        if fn_name == "tcpConnect" and len(args) == 2:
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_io_connect_boxed\"(i8* " + args[0] + ", i8* " + args[1] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[1] + ")")
            return v
        if fn_name == "ord" and len(args) > 0:
            return gen_builtin_unary(b, "fray_ord", args)
        if fn_name == "chr" and len(args) > 0:
            return gen_builtin_unary(b, "fray_chr", args)
        if fn_name == "isqrt" and len(args) > 0:
            return gen_builtin_unary(b, "fray_isqrt", args)
        if fn_name == "round" and len(args) > 0:
            return gen_builtin_unary(b, "fray_round_val", args)
        if fn_name == "sum" and len(args) > 0:
            return gen_builtin_unary(b, "fray_sum", args)
        if fn_name == "mean" and len(args) > 0:
            return gen_builtin_unary(b, "fray_mean", args)
        if fn_name == "med" and len(args) > 0:
            return gen_builtin_unary(b, "fray_med", args)
        if fn_name == "mid" and len(args) > 0:
            return gen_builtin_unary(b, "fray_mid", args)
        if fn_name == "mode" and len(args) > 0:
            return gen_builtin_unary(b, "fray_mode", args)
        if fn_name == "atomic" and len(args) > 0:
            return gen_builtin_unary(b, "fray_atomic_new", args)
        # Threads: spawn hands the runtime a function object (a bare function
        # name is one, via gen_function_value) and the thread trampoline calls
        # its wrapper with no arguments, so a target that declares parameters
        # is refused here rather than failing inside the thread — the bootstrap
        # engine and the oracle reject it too.
        if fn_name == "spawn" and len(args) > 0:
            target = node["args"][0]
            if node_type(target) == "IDENTIFIER" and target["name"] in b.func_arities:
                if b.func_arities[target["name"]] > 0:
                    codegen_error(node, "spawn() target '" + target["name"] + "' must take no parameters")
                    return gen_none(b)
            tid = fresh_var(b)
            emit(b, "  " + tid + " = call i64 @\"fray_thread_spawn\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            boxed = fresh_var(b)
            emit(b, "  " + boxed + " = call i8* @\"fray_int\"(i64 " + tid + ")")
            return boxed
        if fn_name == "join" and len(args) > 0:
            tid = fresh_var(b)
            emit(b, "  " + tid + " = call i64 @\"fray_as_int\"(i8* " + args[0] + ")")
            emit(b, "  call void @\"fray_thread_join\"(i64 " + tid + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + args[0] + ")")
            return gen_none(b)
        if fn_name == "joinAll":
            emit(b, "  call void @\"fray_thread_join_all\"()")
            return gen_none(b)
        # Option / Result: constructors, the unwrap family and the test
        # predicates are one-argument runtime calls like the math builtins.
        if fn_name == "Some" and len(args) > 0:
            return gen_builtin_unary(b, "fray_some", args)
        if fn_name == "Ok" and len(args) > 0:
            return gen_builtin_unary(b, "fray_ok", args)
        if fn_name == "Err" and len(args) > 0:
            return gen_builtin_unary(b, "fray_err", args)
        if fn_name == "unwrap" and len(args) > 0:
            return gen_builtin_unary(b, "fray_unwrap", args)
        if fn_name == "isSome" and len(args) > 0:
            return gen_builtin_unary(b, "fray_is_some", args)
        if fn_name == "isNone" and len(args) > 0:
            return gen_builtin_unary(b, "fray_is_none_val", args)
        if fn_name == "isOk" and len(args) > 0:
            return gen_builtin_unary(b, "fray_is_ok", args)
        if fn_name == "isErr" and len(args) > 0:
            return gen_builtin_unary(b, "fray_is_err", args)
        if fn_name == "min" and len(args) > 0:
            return gen_builtin_chain(b, "fray_min", args)
        if fn_name == "max" and len(args) > 0:
            return gen_builtin_chain(b, "fray_max", args)
        if fn_name in b.extern_names:
            return gen_extern_call(b, node, fn_name, args)
        if fn_name in b.func_vars or fn_name in b.global_vars:
            # A name that holds a value (a parameter, a local, a module
            # global): the callee is not a function this compiler resolved, so
            # the call goes through the runtime — `g = add` then `g(4, 5)`.
            fn_val = gen_expr(b, fn)
            v = gen_call_with_args(b, fn_val, args)
            emit(b, "  call void @\"fray_release\"(i8* " + fn_val + ")")
            return v
        if not (fn_name in b.func_names):
            if fn_name in KNOWN_BUILTINS:
                codegen_error(node, "builtin '" + fn_name + "' is not supported by the self-hosted codegen yet")
            else:
                codegen_error(node, "call to undefined function '" + fn_name + "'")
        v = fresh_var(b)
        arg_str = ""
        i = 0
        while i < len(args):
            if i > 0:
                arg_str = arg_str + ", "
            arg_str = arg_str + "i8* " + args[i]
            i = i + 1
        emit(b, "  " + v + " = call i8* @\"" + fn_name + "\"(" + arg_str + ")")
        # The callee owns its parameters (see gen_func_def): each slot is
        # dropped on the callee's return path, so this call hands the argument
        # references over and must not release them itself.
        return v
    if nt == "LIST_LITERAL":
        v = fresh_var(b)
        emit(b, "  " + v + " = call i8* @\"fray_list\"()")
        i = 0
        while i < len(node["elements"]):
            ev = gen_expr(b, node["elements"][i])
            emit(b, "  call void @\"fray_list_append\"(i8* " + v + ", i8* " + ev + ")")
            # The list holds its own reference to every element (append
            # retains), so the one this call created is dropped — without this
            # each literal element leaked one box, which the ASan sweep on
            # driver-compiled programs caught.
            emit(b, "  call void @\"fray_release\"(i8* " + ev + ")")
            i = i + 1
        return v
    if nt == "MAP_LITERAL":
        v = fresh_var(b)
        emit(b, "  " + v + " = call i8* @\"fray_map_new\"()")
        i = 0
        while i < len(node["keys"]):
            kv = gen_expr(b, node["keys"][i])
            vv = gen_expr(b, node["values"][i])
            emit(b, "  call void @\"fray_map_set\"(i8* " + v + ", i8* " + kv + ", i8* " + vv + ")")
            i = i + 1
        return v
    if nt == "INDEX_ACCESS":
        if node_type(node["index"]) == "SLICE":
            return gen_slice(b, node)
        obj = gen_expr(b, node["obj"])
        idx = gen_expr(b, node["index"])
        # Runtime tag dispatch, mirroring the oracle: map -> tuple -> string ->
        # list. Without the tuple and string arms, indexing either of those fell
        # into the list path and threw "TypeError: not a list" at run time.
        tag_byte = fresh_var(b)
        emit(b, "  " + tag_byte + " = load i8, i8* " + obj)
        is_map = fresh_var(b)
        emit(b, "  " + is_map + " = icmp eq i8 " + tag_byte + ", " + str(TAG_MAP))
        do_map = fresh_block(b, "get_map")
        chk_tuple = fresh_block(b, "get_chk_tuple")
        do_tuple = fresh_block(b, "get_tuple")
        chk_string = fresh_block(b, "get_chk_string")
        do_string = fresh_block(b, "get_string")
        do_list = fresh_block(b, "get_list")
        done_blk = fresh_block(b, "get_done")
        emit(b, "  br i1 " + is_map + ", label %" + do_map + ", label %" + chk_tuple)
        emit(b, do_map + ":")
        res_map = fresh_var(b)
        emit(b, "  " + res_map + " = call i8* @\"fray_map_get\"(i8* " + obj + ", i8* " + idx + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + idx + ")")
        emit(b, "  br label %" + done_blk)
        emit(b, chk_tuple + ":")
        is_tuple = fresh_var(b)
        emit(b, "  " + is_tuple + " = icmp eq i8 " + tag_byte + ", " + str(TAG_TUPLE))
        emit(b, "  br i1 " + is_tuple + ", label %" + do_tuple + ", label %" + chk_string)
        emit(b, do_tuple + ":")
        idx_t = fresh_var(b)
        emit(b, "  " + idx_t + " = call i64 @\"fray_as_int\"(i8* " + idx + ")")
        res_tuple = fresh_var(b)
        emit(b, "  " + res_tuple + " = call i8* @\"fray_tuple_index\"(i8* " + obj + ", i64 " + idx_t + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + idx + ")")
        emit(b, "  br label %" + done_blk)
        emit(b, chk_string + ":")
        is_string = fresh_var(b)
        emit(b, "  " + is_string + " = icmp eq i8 " + tag_byte + ", " + str(TAG_STRING))
        emit(b, "  br i1 " + is_string + ", label %" + do_string + ", label %" + do_list)
        emit(b, do_string + ":")
        idx_s = fresh_var(b)
        emit(b, "  " + idx_s + " = call i64 @\"fray_as_int\"(i8* " + idx + ")")
        res_string = fresh_var(b)
        emit(b, "  " + res_string + " = call i8* @\"fray_string_index\"(i8* " + obj + ", i64 " + idx_s + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + idx + ")")
        emit(b, "  br label %" + done_blk)
        emit(b, do_list + ":")
        idx_int = fresh_var(b)
        emit(b, "  " + idx_int + " = call i64 @\"fray_as_int\"(i8* " + idx + ")")
        res_list = fresh_var(b)
        emit(b, "  " + res_list + " = call i8* @\"fray_list_index\"(i8* " + obj + ", i64 " + idx_int + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + idx + ")")
        emit(b, "  br label %" + done_blk)
        emit(b, done_blk + ":")
        v = fresh_var(b)
        emit(b, "  " + v + " = phi i8* [" + res_map + ", %" + do_map + "], [" + res_tuple + ", %" + do_tuple + "], [" + res_string + ", %" + do_string + "], [" + res_list + ", %" + do_list + "]")
        emit(b, "  call void @\"fray_release\"(i8* " + obj + ")")
        return v
    if nt == "MATCH_EXPR":
        return gen_match(b, node)
    if nt == "SET_LITERAL":
        v = fresh_var(b)
        emit(b, "  " + v + " = call i8* @\"fray_set\"()")
        i = 0
        while i < len(node["elements"]):
            ev = gen_expr(b, node["elements"][i])
            # fray_set_append, not fray_list_append. The two share the union
            # fields they write through, so the list call appeared to work on
            # a set — but it skips the membership check, so `{1, 1, 2}` built
            # a three-element "set" here and a two-element one in the oracle.
            emit(b, "  call void @\"fray_set_append\"(i8* " + v + ", i8* " + ev + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + ev + ")")
            i = i + 1
        return v
    if nt == "MEMBER_ACCESS":
        # An enum-variant value — 'Color.Red' with no call — is how the oracle
        # and the bootstrap engine write a parameterless variant (match_basic
        # and enum_basic are made of it). The enum name is a type, not a
        # value, so this must be resolved before the object expression is
        # evaluated; the call form 'Color.Green(args)' is handled in the CALL
        # branch.
        attr = node["attr"]
        if node_type(node["obj"]) == "IDENTIFIER" and node["obj"]["name"] in b.enum_defs:
            ename = node["obj"]["name"]
            einfo = b.enum_defs[ename]
            j = 0
            found_variant = False
            while j < len(einfo["cases"]):
                if einfo["cases"][j]["name"] == attr:
                    found_variant = True
                    # Only the parameterless value form is lowered. A bare
                    # parameterized variant is not a value anywhere: the
                    # oracle turns it into an unusable placeholder and the
                    # bootstrap engine rejects it at compile time, so
                    # compiling it is not an option.
                    if len(einfo["cases"][j]["params"]) > 0:
                        codegen_error(node, "bare enum-variant references of a parameterized variant like '" + ename + "." + attr + "' are not supported by the self-hosted codegen — call it as '" + ename + "." + attr + "(args)'")
                        return "null"
                    return gen_enum_new(b, ename, einfo, attr, [])
                j = j + 1
            # A member of an enum name that is not a variant is a compile-time
            # error in the oracle ("'Color' has no variant 'Bogus'").
            if not found_variant:
                codegen_error(node, "'" + ename + "' has no variant '" + attr + "'")
                return "null"
        obj = gen_expr(b, node["obj"])
        # Try common methods
        if attr == "upper" or attr == "lower" or attr == "trim":
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_string_" + attr + "\"(i8* " + obj + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + obj + ")")
            return v
        if attr == "keys":
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_map_keys\"(i8* " + obj + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + obj + ")")
            return v
        if attr == "depend":
            # A bare `x.depend` is an attribute read, not a call, and it must
            # not pop: the reference writes the paren-less form in its list
            # section (where the value is discarded), and popping there would
            # make the documented line destructive in this engine and inert in
            # the oracle. `.depend()` is the call form, and it dispatches (see
            # fray_depend).
            emit(b, "  call void @\"fray_release\"(i8* " + obj + ")")
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_none\"()")
            return v
        # Default: struct field get
        field_str = fresh_var(b)
        ref = string_const_ref(b, attr)
        emit(b, "  " + field_str + " = " + ref)
        v = fresh_var(b)
        emit(b, "  " + v + " = call i8* @\"fray_struct_field_get\"(i8* " + obj + ", i8* " + field_str + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + obj + ")")
        return v
    return "null"

# ─── Unboxed slots ───
# The machine-value side of the inference pass above. A name this emitter has
# given a raw slot (b.raw_vars) holds an i64 or a double instead of an i8*:
# there is no box to allocate, no reference to retain on a read, and none to
# release on a rebind or a return. Every transition between the two worlds
# goes through fray_as_int / fray_as_float, the runtime's own tag-checked
# conversions, so the guard is in one place rather than in every read.

def expr_ty(b, node):
    # What the inference pass proved about this expression in the function
    # being generated. The module scope has no env, so every name there reads
    # as unknown: its variables are globals (see compile_ir), not this
    # frame's slots.
    return inf_expr(b.infer, node, b.cur_fn, b.var_tys)

def raw_ty(kind):
    # The LLVM type a raw slot of this kind holds.
    if kind == TY_FLOAT:
        return "double"
    return "i64"

def box_raw(b, val, kind):
    # A machine value back in a box, owned by the caller.
    v = fresh_var(b)
    if kind == TY_FLOAT:
        emit(b, "  " + v + " = call i8* @\"fray_float\"(double " + val + ")")
        return v
    emit(b, "  " + v + " = call i8* @\"fray_int\"(i64 " + val + ")")
    return v

def unbox_as(b, node, kind):
    # The machine value an expression stands for, as this slot's kind.
    if kind == TY_FLOAT:
        return unbox_float(b, node)
    return unbox_int(b, node)

def load_raw(b, name):
    # The current machine value of a raw slot.
    slot = b.raw_vars[name]
    v = fresh_var(b)
    emit(b, "  " + v + " = load " + raw_ty(b.slot_kinds[name]) + ", " + raw_ty(b.slot_kinds[name]) + "* " + slot)
    return v

def store_raw(b, name, val):
    slot = b.raw_vars[name]
    emit(b, "  store " + raw_ty(b.slot_kinds[name]) + " " + val + ", " + raw_ty(b.slot_kinds[name]) + "* " + slot)

def unbox_int(b, node):
    # The i64 a proven-int expression stands for, boxed only where it really
    # has to be. An int literal is a constant (no instruction at all), a raw
    # slot is a load, an int/int arithmetic node is machine arithmetic, and
    # anything else is generated as a value and handed to fray_as_int.
    if node == null:
        return "0"
    nt = node_type(node)
    if nt == "INT_LITERAL":
        return node["value"]
    if nt == "BOOL_LITERAL":
        if node["value"] == "True":
            return "1"
        return "0"
    if nt == "IDENTIFIER" and node["name"] in b.raw_vars:
        name = node["name"]
        if b.slot_kinds[name] == TY_INT:
            return load_raw(b, name)
        # A float slot reached through an int expression: the runtime's own
        # conversion, not an fptosi, whose out-of-range result is undefined.
        f = load_raw(b, name)
        box = box_raw(b, f, TY_FLOAT)
        v = fresh_var(b)
        emit(b, "  " + v + " = call i64 @\"fray_as_int\"(i8* " + box + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + box + ")")
        return v
    if nt == "BINARY_OP" and raw_int_ready(b, node):
        return raw_int_binop(b, node)
    v = gen_expr(b, node)
    i = fresh_var(b)
    emit(b, "  " + i + " = call i64 @\"fray_as_int\"(i8* " + v + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + v + ")")
    return i

def unbox_float(b, node):
    # The double a proven-float expression stands for (see unbox_int).
    if node == null:
        return "0.0"
    nt = node_type(node)
    if nt == "FLOAT_LITERAL":
        return node["value"]
    if nt == "IDENTIFIER" and node["name"] in b.raw_vars:
        name = node["name"]
        if b.slot_kinds[name] == TY_FLOAT:
            return load_raw(b, name)
        # fray_as_float on a boxed int is C's (double) cast, which sitofp
        # reproduces exactly.
        i = load_raw(b, name)
        v = fresh_var(b)
        emit(b, "  " + v + " = sitofp i64 " + i + " to double")
        return v
    if nt == "BINARY_OP" and raw_float_ready(b, node):
        return raw_float_binop(b, node)
    if nt == "UNARY_OP" and node["op"] == "-":
        # fneg of a negation, with no box on the way through.
        v = unbox_float(b, node["operand"])
        r = fresh_var(b)
        emit(b, "  " + r + " = fneg double " + v)
        return r
    v = gen_expr(b, node)
    f = fresh_var(b)
    emit(b, "  " + f + " = call double @\"fray_as_float\"(i8* " + v + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + v + ")")
    return f

def raw_int_ready(b, node):
    # True when this binary node is machine arithmetic on two ints: an int/int
    # (or bool/int) operand pair, and an operator this emitter knows. Anything
    # else stays on the boxed path, where the runtime still decides.
    op = node["op"]
    if not (op == "+" or op == "-" or op == "*" or op == "//" or op == "%"):
        return False
    lt = expr_ty(b, node["left"])
    rt = expr_ty(b, node["right"])
    if lt == TY_INT or lt == TY_BOOL:
        if rt == TY_INT or rt == TY_BOOL:
            return True
    return False

def raw_float_ready(b, node):
    op = node["op"]
    if not (op == "+" or op == "-" or op == "*"):
        return False
    lt = expr_ty(b, node["left"])
    rt = expr_ty(b, node["right"])
    if not ty_numeric(lt):
        return False
    if not ty_numeric(rt):
        return False
    if lt == TY_BOOL:
        return False
    if rt == TY_BOOL:
        return False
    return True

def raw_int_binop(b, node):
    # Raw i64 arithmetic. The operands are unboxed rather than boxed, so a
    # loop body like `s += i % 7` costs no allocation at all.
    op = node["op"]
    l = unbox_int(b, node["left"])
    r = unbox_int(b, node["right"])
    if op == "//":
        return raw_floordiv(b, l, r)
    if op == "%":
        return raw_mod(b, l, r)
    return raw_iop(b, op, l, r)

def raw_iop(b, op, l, r):
    v = fresh_var(b)
    if op == "-":
        emit(b, "  " + v + " = sub i64 " + l + ", " + r)
        return v
    if op == "*":
        emit(b, "  " + v + " = mul i64 " + l + ", " + r)
        return v
    emit(b, "  " + v + " = add i64 " + l + ", " + r)
    return v

def raw_float_binop(b, node):
    op = node["op"]
    l = unbox_float_as_num(b, node["left"])
    r = unbox_float_as_num(b, node["right"])
    v = fresh_var(b)
    if op == "-":
        emit(b, "  " + v + " = fsub double " + l + ", " + r)
        return v
    if op == "*":
        emit(b, "  " + v + " = fmul double " + l + ", " + r)
        return v
    emit(b, "  " + v + " = fadd double " + l + ", " + r)
    return v

def unbox_float_as_num(b, node):
    # A numeric operand of float arithmetic: an int is widened, exactly as the
    # boxed path's fray_as_float would.
    if expr_ty(b, node) == TY_INT:
        v = unbox_int(b, node)
        f = fresh_var(b)
        emit(b, "  " + f + " = sitofp i64 " + v + " to double")
        return f
    return unbox_float(b, node)

def raw_guard_zero(b, r):
    # The zero-divisor guard the runtime's own // and % carry: branch to a
    # block that raises ZeroDivisionError (FRAY_EXC_ZERO_DIV, the same code
    # runtime/ops.c passes) and merges the runtime's fallback value, or carry
    # on. Returns (throw block, ok block, merge block, fix block).
    zero = fresh_var(b)
    emit(b, "  " + zero + " = icmp eq i64 " + r + ", 0")
    slow = fresh_block(b, "rawdiv_slow")
    ok = fresh_block(b, "rawdiv_ok")
    merge = fresh_block(b, "rawdiv_merge")
    fix = fresh_block(b, "rawdiv_fix")
    emit(b, "  br i1 " + zero + ", label %" + slow + ", label %" + ok)
    emit(b, slow + ":")
    msg = fresh_var(b)
    ref = string_const_ref(b, "ZeroDivisionError: division by zero")
    emit(b, "  " + msg + " = " + ref)
    emit(b, "  call void @\"fray_throw\"(i32 5, i8* " + msg + ")")
    emit(b, "  br label %" + merge)
    emit(b, ok + ":")
    return (slow, ok, merge, fix)

def raw_mod(b, l, r):
    # Euclidean modulo, as runtime/ops.c::fray_mod computes it: srem, plus the
    # divisor when the remainder's sign differs from the divisor's.
    names = raw_guard_zero(b, r)
    slow = names[0]
    ok = names[1]
    merge = names[2]
    fix = names[3]
    rm = fresh_var(b)
    emit(b, "  " + rm + " = srem i64 " + l + ", " + r)
    nz = fresh_var(b)
    emit(b, "  " + nz + " = icmp ne i64 " + rm + ", 0")
    x = fresh_var(b)
    emit(b, "  " + x + " = xor i64 " + rm + ", " + r)
    signs = fresh_var(b)
    emit(b, "  " + signs + " = icmp slt i64 " + x + ", 0")
    need = fresh_var(b)
    emit(b, "  " + need + " = and i1 " + nz + ", " + signs)
    emit(b, "  br i1 " + need + ", label %" + fix + ", label %" + merge)
    emit(b, fix + ":")
    rm2 = fresh_var(b)
    emit(b, "  " + rm2 + " = add i64 " + rm + ", " + r)
    emit(b, "  br label %" + merge)
    emit(b, merge + ":")
    v = fresh_var(b)
    emit(b, "  " + v + " = phi i64 [0, %" + slow + "], [" + rm + ", %" + ok + "], [" + rm2 + ", %" + fix + "]")
    return v

def raw_floordiv(b, l, r):
    # Floor division, as runtime/ops.c::fray_floordiv computes it: sdiv, minus
    # one when the division truncated and the operands had different signs.
    names = raw_guard_zero(b, r)
    slow = names[0]
    ok = names[1]
    merge = names[2]
    fix = names[3]
    q = fresh_var(b)
    emit(b, "  " + q + " = sdiv i64 " + l + ", " + r)
    rm = fresh_var(b)
    emit(b, "  " + rm + " = srem i64 " + l + ", " + r)
    nz = fresh_var(b)
    emit(b, "  " + nz + " = icmp ne i64 " + rm + ", 0")
    x = fresh_var(b)
    emit(b, "  " + x + " = xor i64 " + l + ", " + r)
    signs = fresh_var(b)
    emit(b, "  " + signs + " = icmp slt i64 " + x + ", 0")
    need = fresh_var(b)
    emit(b, "  " + need + " = and i1 " + nz + ", " + signs)
    emit(b, "  br i1 " + need + ", label %" + fix + ", label %" + merge)
    emit(b, fix + ":")
    q2 = fresh_var(b)
    emit(b, "  " + q2 + " = sub i64 " + q + ", 1")
    emit(b, "  br label %" + merge)
    emit(b, merge + ":")
    v = fresh_var(b)
    emit(b, "  " + v + " = phi i64 [0, %" + slow + "], [" + q + ", %" + ok + "], [" + q2 + ", %" + fix + "]")
    return v

def raw_cmp(b, op, lt, l, r):
    # A comparison of two machine values, as the i1 its condition or its box
    # needs. Signed, like the bootstrap's icmp_signed.
    pred = "eq"
    if op == "!=":
        pred = "ne"
    if op == "<":
        pred = "slt"
    if op == ">":
        pred = "sgt"
    if op == "<=":
        pred = "sle"
    if op == ">=":
        pred = "sge"
    if lt == TY_FLOAT:
        fpred = "oeq"
        if op == "!=":
            fpred = "one"
        if op == "<":
            fpred = "olt"
        if op == ">":
            fpred = "ogt"
        if op == "<=":
            fpred = "ole"
        if op == ">=":
            fpred = "oge"
        v = fresh_var(b)
        emit(b, "  " + v + " = fcmp " + fpred + " double " + l + ", " + r)
        return v
    v = fresh_var(b)
    emit(b, "  " + v + " = icmp " + pred + " i64 " + l + ", " + r)
    return v

def gen_cond(b, node):
    # An i1 condition, with the box skipped where the inference pass proved
    # what the condition is: a comparison of two numbers becomes the icmp (or
    # fcmp) itself, and a number becomes a zero test. Loop-critical.
    nt = node_type(node)
    t = expr_ty(b, node)
    if nt == "BINARY_OP" and node["op"] in CMP_OPS:
        lt = expr_ty(b, node["left"])
        rt = expr_ty(b, node["right"])
        if raw_cmp_ready(lt) and raw_cmp_ready(rt):
            l = unbox_as(b, node["left"], cmp_kind(lt, rt))
            r = unbox_as(b, node["right"], cmp_kind(lt, rt))
            return raw_cmp(b, node["op"], cmp_kind(lt, rt), l, r)
    if t == TY_INT:
        i = unbox_int(b, node)
        v = fresh_var(b)
        emit(b, "  " + v + " = icmp ne i64 " + i + ", 0")
        return v
    if t == TY_FLOAT:
        f = unbox_float(b, node)
        v = fresh_var(b)
        emit(b, "  " + v + " = fcmp one double " + f + ", 0.0")
        return v
    val = gen_expr(b, node)
    truthy = fresh_var(b)
    emit(b, "  " + truthy + " = call i1 @\"fray_is_truthy\"(i8* " + val + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + val + ")")
    return truthy

def raw_cmp_ready(t):
    if t == TY_INT or t == TY_BOOL:
        return True
    if t == TY_FLOAT:
        return True
    return False

def cmp_kind(lt, rt):
    # The machine type a comparison of these two operand types runs in: a
    # float anywhere makes it a float comparison, as fray_eq/fray_lt do
    # through to_float.
    if lt == TY_FLOAT or rt == TY_FLOAT:
        return TY_FLOAT
    return TY_INT

def gen_store_raw(b, name, node, op):
    # Bind a raw slot. `op` is "=" for a plain assignment and the augmented
    # form ("+=" and friends) otherwise, in which case the machine value
    # already in the slot is one of the operands and no box is made at all.
    kind = b.slot_kinds[name]
    if op == "=":
        if expr_ty(b, node) == kind:
            store_raw(b, name, unbox_as(b, node, kind))
            return
        # A value this pass could not type: convert it through the runtime.
        val = gen_expr(b, node)
        f = "0"
        if kind == TY_FLOAT:
            f = fresh_var(b)
            emit(b, "  " + f + " = call double @\"fray_as_float\"(i8* " + val + ")")
        else:
            f = fresh_var(b)
            emit(b, "  " + f + " = call i64 @\"fray_as_int\"(i8* " + val + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + val + ")")
        store_raw(b, name, f)
        return
    base = AUG_BASE[op]
    cur = load_raw(b, name)
    rhs_ty = expr_ty(b, node)
    if kind == TY_INT and rhs_ty == TY_INT and (base == "+" or base == "-" or base == "*" or base == "//" or base == "%"):
        r = unbox_int(b, node)
        if base == "//":
            store_raw(b, name, raw_floordiv(b, cur, r))
            return
        if base == "%":
            store_raw(b, name, raw_mod(b, cur, r))
            return
        store_raw(b, name, raw_iop(b, base, cur, r))
        return
    if kind == TY_FLOAT and rhs_ty == TY_FLOAT and (base == "+" or base == "-" or base == "*"):
        r = unbox_float(b, node)
        v = fresh_var(b)
        if base == "-":
            emit(b, "  " + v + " = fsub double " + cur + ", " + r)
        elif base == "*":
            emit(b, "  " + v + " = fmul double " + cur + ", " + r)
        else:
            emit(b, "  " + v + " = fadd double " + cur + ", " + r)
        store_raw(b, name, v)
        return
    # Everything else (`^=`, and any operator whose right-hand side this pass
    # could not type) goes through the runtime, exactly as the boxed path did.
    left = box_raw(b, cur, kind)
    right = gen_expr(b, node)
    res = fresh_var(b)
    emit(b, "  " + res + " = call i8* @\"" + AUGOP_MAP[op] + "\"(i8* " + left + ", i8* " + right + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + left + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + right + ")")
    # Bound before the branch, not inside it: an `if` body is its own scope in
    # the evaluator, so a name introduced in one is gone by the time the store
    # below reads it. The plain-assignment path above already does this.
    f = "0"
    if kind == TY_FLOAT:
        f = fresh_var(b)
        emit(b, "  " + f + " = call double @\"fray_as_float\"(i8* " + res + ")")
    else:
        f = fresh_var(b)
        emit(b, "  " + f + " = call i64 @\"fray_as_int\"(i8* " + res + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + res + ")")
    store_raw(b, name, f)
    return

def decide_slots(b, node):
    # Which of this function's names get a machine slot instead of a boxed
    # one. The decision is made once, here, from the inference pass's env for
    # this function, so every read, rebind and return of a name sees the same
    # representation. Module globals are excluded: a name assigned at module
    # scope is a global (compile_ir), shared with every spawned thread, and
    # the frame's alloca is not what a write to it lands in. A name the pass
    # poisoned (bound by a match arm or an except clause, or dropped by a
    # `del`) never reaches this table, which is what lets those binding sites
    # keep writing an i8* into a slot of the name they bind.
    kinds = {}
    if node_get(node, "is_async", False):
        return kinds
    env = b.var_tys
    for name in env:
        t = env[name]
        if t != TY_INT and t != TY_FLOAT:
            continue
        if name in b.global_vars:
            continue
        kinds[name] = t
    return kinds

def unbox_name(kind):
    # The runtime conversion a slot of this kind unwraps through.
    if kind == TY_FLOAT:
        return "float"
    return "int"

def declare_raw(b, name, kind):
    # The entry-block alloca a raw slot lives in. Emitted with the other
    # allocas, before any other instruction, so it dominates every use. Zeroed
    # for the same reason the boxed slots are nulled: a name read before
    # anything wrote it is a program bug, and a defined 0 keeps that from
    # turning into whatever the stack held.
    slot = "%" + name + ".raw"
    emit(b, "  " + slot + " = alloca " + raw_ty(kind))
    zero = "0"
    if kind == TY_FLOAT:
        zero = "0.0"
    emit(b, "  store " + raw_ty(kind) + " " + zero + ", " + raw_ty(kind) + "* " + slot)
    b.raw_vars[name] = slot
    return slot

def store_raw_param(b, name, kind, arg):
    # Unbox a parameter at entry and release the box the caller handed over:
    # the frame owns its arguments (see gen_func_def), and a machine slot has
    # no reference to release later.
    f = "0"
    if kind == TY_FLOAT:
        f = fresh_var(b)
        emit(b, "  " + f + " = call double @\"fray_as_float\"(i8* " + arg + ")")
    else:
        f = fresh_var(b)
        emit(b, "  " + f + " = call i64 @\"fray_as_int\"(i8* " + arg + ")")
    emit(b, "  store " + raw_ty(kind) + " " + f + ", " + raw_ty(kind) + "* " + b.raw_vars[name])
    emit(b, "  call void @\"fray_release\"(i8* " + arg + ")")

# ─── Statement codegen ───

def ident_slot(b, name):
    # Slot string for a variable: local alloca if declared, else global.
    # (Written as a function because variables assigned inside if-blocks
    # do not leak out of the block in fray.)
    if name in b.func_vars:
        return b.func_vars[name]
    return "@\"" + name + "\""

def gen_aug_assignment(b, node):
    # x += v, x -= v, etc. — identifier, index (m[k], lst[i]), and
    # struct-field (p.x) targets.
    target = node["target"]
    op = node["op"]
    fn = AUGOP_MAP[op]
    if node_type(target) == "IDENTIFIER":
        name = target["name"]
        if name in b.raw_vars:
            gen_store_raw(b, name, node["value"], op)
            return
        slot = ident_slot(b, name)
        old = fresh_var(b)
        emit(b, "  " + old + " = load i8*, i8** " + slot)
        val = gen_expr(b, node["value"])
        nv = fresh_var(b)
        emit(b, "  " + nv + " = call i8* @\"" + fn + "\"(i8* " + old + ", i8* " + val + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + old + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + val + ")")
        emit(b, "  store i8* " + nv + ", i8** " + slot)
    elif node_type(target) == "INDEX_ACCESS":
        # obj[idx] op= val — runtime tag dispatch: TAG_MAP (12) -> map path
        # (fray_map_set takes ownership of key and val), else list path
        # (fray_list_setindex does not).
        obj = gen_expr(b, target["obj"])
        idx = gen_expr(b, target["index"])
        tag_byte = fresh_var(b)
        emit(b, "  " + tag_byte + " = load i8, i8* " + obj)
        is_map = fresh_var(b)
        emit(b, "  " + is_map + " = icmp eq i8 " + tag_byte + ", 12")
        do_map = fresh_block(b, "aug_map")
        do_list = fresh_block(b, "aug_list")
        done_blk = fresh_block(b, "aug_done")
        emit(b, "  br i1 " + is_map + ", label %" + do_map + ", label %" + do_list)
        emit(b, do_map + ":")
        cur_m = fresh_var(b)
        emit(b, "  " + cur_m + " = call i8* @\"fray_map_get\"(i8* " + obj + ", i8* " + idx + ")")
        val_m = gen_expr(b, node["value"])
        res_m = fresh_var(b)
        emit(b, "  " + res_m + " = call i8* @\"" + fn + "\"(i8* " + cur_m + ", i8* " + val_m + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + cur_m + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + val_m + ")")
        emit(b, "  call void @\"fray_map_set\"(i8* " + obj + ", i8* " + idx + ", i8* " + res_m + ")")
        emit(b, "  br label %" + done_blk)
        emit(b, do_list + ":")
        idx_int = fresh_var(b)
        emit(b, "  " + idx_int + " = call i64 @\"fray_as_int\"(i8* " + idx + ")")
        cur_l = fresh_var(b)
        emit(b, "  " + cur_l + " = call i8* @\"fray_list_index\"(i8* " + obj + ", i64 " + idx_int + ")")
        val_l = gen_expr(b, node["value"])
        res_l = fresh_var(b)
        emit(b, "  " + res_l + " = call i8* @\"" + fn + "\"(i8* " + cur_l + ", i8* " + val_l + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + cur_l + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + val_l + ")")
        emit(b, "  call void @\"fray_list_setindex\"(i8* " + obj + ", i64 " + idx_int + ", i8* " + res_l + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + res_l + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + idx + ")")
        emit(b, "  br label %" + done_blk)
        emit(b, done_blk + ":")
        emit(b, "  call void @\"fray_release\"(i8* " + obj + ")")
    elif node_type(target) == "MEMBER_ACCESS":
        # p.f op= val — field_get returns +1; field_set takes ownership
        # of the result.
        obj = gen_expr(b, target["obj"])
        field_str = fresh_var(b)
        ref = string_const_ref(b, target["attr"])
        emit(b, "  " + field_str + " = " + ref)
        cur = fresh_var(b)
        emit(b, "  " + cur + " = call i8* @\"fray_struct_field_get\"(i8* " + obj + ", i8* " + field_str + ")")
        val = gen_expr(b, node["value"])
        nv = fresh_var(b)
        emit(b, "  " + nv + " = call i8* @\"" + fn + "\"(i8* " + cur + ", i8* " + val + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + cur + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + val + ")")
        emit(b, "  call void @\"fray_struct_field_set\"(i8* " + obj + ", i8* " + field_str + ", i8* " + nv + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + obj + ")")

def gen_stmt(b, node):
    if node == null:
        return
    nt = node_type(node)
    if nt == "IMPORT_STMT":
        # Imports are not resolved by this codegen. Record the module name so a
        # later use of it is reported as "not supported" rather than as an
        # unknown name (which would wrongly suggest a typo).
        b.modules[node["module"]] = True
        return
    if nt == "ASSIGNMENT":
        target = node["target"]
        op = node_get(node, "op", "=")
        # A machine slot is bound before the value is generated: an int
        # literal, or arithmetic on machine values, is stored with no box at
        # all (see gen_store_raw).
        if node_type(target) == "IDENTIFIER" and target["name"] in b.raw_vars:
            gen_store_raw(b, target["name"], node["value"], op)
            return
        val = gen_expr(b, node["value"])
        if node_type(target) == "IDENTIFIER":
            name = target["name"]
            if op != "=" and name in b.func_vars:
                old = fresh_var(b)
                emit(b, "  " + old + " = load i8*, i8** " + b.func_vars[name])
                nv = fresh_var(b)
                fn = "fray_add"
                if op in AUGOP_MAP:
                    fn = AUGOP_MAP[op]
                emit(b, "  " + nv + " = call i8* @\"" + fn + "\"(i8* " + old + ", i8* " + val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + old + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + val + ")")
                emit(b, "  store i8* " + nv + ", i8** " + b.func_vars[name])
            elif op != "=":
                old = fresh_var(b)
                emit(b, "  " + old + " = load i8*, i8** @\"" + name + "\"")
                nv = fresh_var(b)
                fn = "fray_add"
                if op in AUGOP_MAP:
                    fn = AUGOP_MAP[op]
                emit(b, "  " + nv + " = call i8* @\"" + fn + "\"(i8* " + old + ", i8* " + val + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + old + ")")
                emit(b, "  call void @\"fray_release\"(i8* " + val + ")")
                emit(b, "  store i8* " + nv + ", i8** @\"" + name + "\"")
            elif name in b.func_vars:
                # A slot this frame owns — a local or a parameter alike: drop
                # the old value and store the new one (see gen_func_def).
                old = fresh_var(b)
                emit(b, "  " + old + " = load i8*, i8** " + b.func_vars[name])
                emit(b, "  store i8* " + val + ", i8** " + b.func_vars[name])
                emit(b, "  call void @\"fray_release\"(i8* " + old + ")")
            else:
                old = fresh_var(b)
                emit(b, "  " + old + " = load i8*, i8** @\"" + name + "\"")
                emit(b, "  store i8* " + val + ", i8** @\"" + name + "\"")
                emit(b, "  call void @\"fray_release\"(i8* " + old + ")")
        elif node_type(target) == "INDEX_ACCESS":
            obj = gen_expr(b, target["obj"])
            idx = gen_expr(b, target["index"])
            # Runtime tag dispatch: TAG_MAP (12) -> fray_map_set (takes
            # ownership of key and val); otherwise list path.
            tag_byte = fresh_var(b)
            emit(b, "  " + tag_byte + " = load i8, i8* " + obj)
            is_map = fresh_var(b)
            emit(b, "  " + is_map + " = icmp eq i8 " + tag_byte + ", 12")
            do_map = fresh_block(b, "set_map")
            do_list = fresh_block(b, "set_list")
            done_blk = fresh_block(b, "set_done")
            emit(b, "  br i1 " + is_map + ", label %" + do_map + ", label %" + do_list)
            emit(b, do_map + ":")
            emit(b, "  call void @\"fray_map_set\"(i8* " + obj + ", i8* " + idx + ", i8* " + val + ")")
            emit(b, "  br label %" + done_blk)
            emit(b, do_list + ":")
            idx_int = fresh_var(b)
            emit(b, "  " + idx_int + " = call i64 @\"fray_as_int\"(i8* " + idx + ")")
            emit(b, "  call void @\"fray_list_setindex\"(i8* " + obj + ", i64 " + idx_int + ", i8* " + val + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + val + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + idx + ")")
            emit(b, "  br label %" + done_blk)
            emit(b, done_blk + ":")
            emit(b, "  call void @\"fray_release\"(i8* " + obj + ")")
        elif node_type(target) == "MEMBER_ACCESS":
            obj = gen_expr(b, target["obj"])
            field_str = fresh_var(b)
            ref = string_const_ref(b, target["attr"])
            emit(b, "  " + field_str + " = " + ref)
            emit(b, "  call void @\"fray_struct_field_set\"(i8* " + obj + ", i8* " + field_str + ", i8* " + val + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + obj + ")")
            # NOTE: fray_struct_field_set takes ownership of val — no release
        return
    if nt == "AUG_ASSIGNMENT":
        gen_aug_assignment(b, node)
        return
    if nt == "EXPR_STMT":
        val = gen_expr(b, node["expr"])
        emit(b, "  call void @\"fray_release\"(i8* " + val + ")")
        return
    if nt == "RETURN_STMT":
        val = node_get(node, "value", null)
        if b.try_dispatch != "":
            # Inside a try body a `return` is not final: the expression that
            # produced its value may have left an exception pending, and that
            # exception has to reach the matching clause (see
            # gen_deferred_return).
            gen_deferred_return(b, gen_return_value(b, val))
            return
        if val != null:
            rv = gen_expr(b, val)
            # The frame's remaining owned values die with this return (see
            # gen_slot_release): the returned value holds its own reference.
            gen_slot_release(b, b.ret_slots)
            emit(b, "  ret i8* " + rv)
        else:
            gen_slot_release(b, b.ret_slots)
            none = fresh_var(b)
            emit(b, "  " + none + " = call i8* @\"fray_none\"()")
            emit(b, "  ret i8* " + none)
        return
    if nt == "IF_STMT":
        gen_if(b, node)
        return
    if nt == "WHILE_LOOP":
        gen_while(b, node)
        return
    if nt == "FOR_LOOP":
        gen_for(b, node)
        return
    if nt == "FUNCTION_DEF":
        gen_func_def(b, node)
        return
    if nt == "CONST_STMT":
        val = gen_expr(b, node["value"])
        name = node["name"]
        b.global_vars[name] = True
        old = fresh_var(b)
        emit(b, "  " + old + " = load i8*, i8** @\"" + name + "\"")
        emit(b, "  store i8* " + val + ", i8** @\"" + name + "\"")
        emit(b, "  call void @\"fray_release\"(i8* " + old + ")")
        return
    if nt == "BREAK_STMT":
        if b.loop_break != "" and not is_terminated(b):
            emit(b, "  br label %" + b.loop_break)
        return
    if nt == "CONTINUE_STMT":
        if b.loop_continue != "" and not is_terminated(b):
            emit(b, "  br label %" + b.loop_continue)
        return
    if nt == "STRUCT_DEF":
        gen_struct_def(b, node)
        return
    if nt == "ENUM_DEF":
        gen_enum_def(b, node)
        return
    if nt == "MATCH_EXPR":
        gen_match(b, node)
        return
    if nt == "TRY_STMT":
        gen_try(b, node)
        return
    if nt == "DEL_STMT":
        gen_del(b, node)
        return
    if nt == "EXTERN_DECL":
        gen_extern(b, node)
        return

def gen_if(b, node):
    truthy = gen_cond(b, node["cond"])
    then_label = fresh_block(b, "if_then")
    else_label = fresh_block(b, "if_else")
    merge_label = fresh_block(b, "if_merge")
    emit(b, "  br i1 " + truthy + ", label %" + then_label + ", label %" + else_label)
    emit(b, then_label + ":")
    for stmt in node["body"]:
        gen_stmt(b, stmt)
    if not is_terminated(b):
        emit(b, "  br label %" + merge_label)
    emit(b, else_label + ":")
    i = 0
    while i < len(node["elif_branches"]):
        branch = node["elif_branches"][i]
        truthy2 = gen_cond(b, branch["cond"])
        then2 = fresh_block(b, "elif_then")
        next2 = fresh_block(b, "elif_next")
        emit(b, "  br i1 " + truthy2 + ", label %" + then2 + ", label %" + next2)
        emit(b, then2 + ":")
        for stmt in branch["body"]:
            gen_stmt(b, stmt)
        if not is_terminated(b):
            emit(b, "  br label %" + merge_label)
        emit(b, next2 + ":")
        i = i + 1
    else_body = node_get(node, "else_body", null)
    if else_body != null:
        for stmt in else_body:
            gen_stmt(b, stmt)
    if not is_terminated(b):
        emit(b, "  br label %" + merge_label)
    emit(b, merge_label + ":")

def gen_while(b, node):
    old_break = b.loop_break
    old_cont = b.loop_continue
    preheader = fresh_block(b, "while_preheader")
    body_label = fresh_block(b, "while_body")
    exit_label = fresh_block(b, "while_exit")
    b.loop_break = exit_label
    b.loop_continue = preheader
    emit(b, "  br label %" + preheader)
    emit(b, preheader + ":")
    truthy = gen_cond(b, node["cond"])
    emit(b, "  br i1 " + truthy + ", label %" + body_label + ", label %" + exit_label)
    emit(b, body_label + ":")
    for stmt in node["body"]:
        gen_stmt(b, stmt)
    if not is_terminated(b):
        emit(b, "  br label %" + preheader)
    emit(b, exit_label + ":")
    b.loop_break = old_break
    b.loop_continue = old_cont

def range_step_value(call):
    # The step of a `range()` this emitter can count, as an integer, or 0 when
    # the range is not countable. The counted loop below picks its comparison
    # from the step's sign, so the step has to be known here, at compile time —
    # the bootstrap's _range_step_static asks the same question of the same
    # call. A step that is a computed value keeps the generic list path (still
    # correct, just not specialised), and so does a literal 0: 0 is this
    # function's "not countable" answer, and the ValueError a zero step must
    # raise comes from the runtime on whichever path the program takes.
    args = call["args"]
    if len(args) < 3:
        return 1
    step = args[2]
    if node_type(step) == "INT_LITERAL":
        # The literal's own text, not its shape, decides the sign: this emitter
        # has to agree with a parser that may hand a negative literal over
        # either folded into the value or as a negation, and a step counted in
        # the wrong direction is an infinite loop rather than a wrong answer.
        return int(step["value"])
    if node_type(step) == "UNARY_OP" and step["op"] == "-":
        inner = step["operand"]
        if node_type(inner) == "INT_LITERAL":
            return 0 - int(inner["value"])
    return 0

def gen_range_bound(b, arg):
    # One bound of a range(), read exactly as runtime/ops.c::fray_range3 reads
    # it: unboxed through fray_as_int — the same silent cast that decides what
    # a non-integer bound means — and the box it came from is dropped.
    v = gen_expr(b, arg)
    i = fresh_var(b)
    emit(b, "  " + i + " = call i64 @\"fray_as_int\"(i8* " + v + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + v + ")")
    return i

def for_var_slot(b, node):
    # The loop variable's slot, declared the first time a loop needs it: this
    # frame's local alloca, or the slot a parameter already has. Returns null
    # when the variable has a machine slot instead — there is nothing to
    # declare there, and nothing to release at the end of an iteration.
    var_name = node["var"]
    if var_name in b.raw_vars:
        return null
    if var_name in b.func_vars:
        return b.func_vars[var_name]
    slot = "%" + var_name
    emit(b, "  " + slot + " = alloca i8*")
    emit(b, "  store i8* null, i8** " + slot)
    b.func_vars[var_name] = slot
    return slot

def gen_for_range(b, node):
    # `for i in range(...)` as a counted loop: the sequence is an i64 that
    # steps by a constant, so no list is built, and where the inference pass
    # gave the loop variable a machine slot no box is made per iteration
    # either. What the generic path below spends a list and an indexing call
    # per element on, this spends one add and one compare on.
    #
    # The bounds are read once, at loop entry, in argument order and through
    # the same fray_as_int the runtime reads them with, so a bound that is a
    # call still happens where it always did and still means what it meant.
    call = node["iterable"]
    args = call["args"]
    step = range_step_value(call)
    # Both bounds are bound here, before the branch that fills them: an `if`
    # body is its own scope in the evaluator (bootstrap/evaluator.py's
    # _exec_block), so a name first assigned inside one is gone by the time
    # the loop below reads it. parse_index_or_slice declares its three the
    # same way, for the same reason.
    start = "0"
    stop = "0"
    if len(args) == 1:
        stop = gen_range_bound(b, args[0])
    else:
        start = gen_range_bound(b, args[0])
        stop = gen_range_bound(b, args[1])
    step_text = str(step)
    # Counting up stops once the index has reached the bound; counting down,
    # once it has reached it from above. The sign is the step's, and the step
    # is a constant, so this is the only decision the loop needs: no
    # per-iteration select, and no zero-step guard (a literal 0 is not a
    # countable step, so it keeps the generic path and the runtime's
    # ValueError).
    cmp_op = "slt"
    if step < 0:
        cmp_op = "sgt"
    old_break = b.loop_break
    old_cont = b.loop_continue
    idx_alloca = fresh_var(b)
    emit(b, "  " + idx_alloca + " = alloca i64")
    # Seeded one step below the start and stepped on the way in, so the loop
    # counter lives entirely in the preheader: `continue` re-enters the
    # preheader and takes its step like any other iteration, and the body
    # never has to carry the index in a block of its own.
    seed = fresh_var(b)
    emit(b, "  " + seed + " = sub i64 " + start + ", " + step_text)
    emit(b, "  store i64 " + seed + ", i64* " + idx_alloca)
    var_alloca = for_var_slot(b, node)
    preheader = fresh_block(b, "range_preheader")
    body_label = fresh_block(b, "range_body")
    exit_label = fresh_block(b, "range_exit")
    b.loop_break = exit_label
    b.loop_continue = preheader
    emit(b, "  br label %" + preheader)
    emit(b, preheader + ":")
    prev = fresh_var(b)
    emit(b, "  " + prev + " = load i64, i64* " + idx_alloca)
    cur = fresh_var(b)
    emit(b, "  " + cur + " = add i64 " + prev + ", " + step_text)
    emit(b, "  store i64 " + cur + ", i64* " + idx_alloca)
    go = fresh_var(b)
    emit(b, "  " + go + " = icmp " + cmp_op + " i64 " + cur + ", " + stop)
    emit(b, "  br i1 " + go + ", label %" + body_label + ", label %" + exit_label)
    emit(b, body_label + ":")
    # One iteration's binding. A machine slot takes the index itself — the
    # whole point, since the element a list would have held is an int either
    # way; a slot proven to be a float gets the converted value, which is what
    # the generic path's fray_as_float on the element box produced. A boxed
    # slot takes ownership of a fresh box and drops the previous iteration's.
    if var_alloca == null:
        var_name = node["var"]
        if b.slot_kinds[var_name] == TY_FLOAT:
            f = fresh_var(b)
            emit(b, "  " + f + " = sitofp i64 " + cur + " to double")
            store_raw(b, var_name, f)
        else:
            store_raw(b, var_name, cur)
    else:
        elem = fresh_var(b)
        emit(b, "  " + elem + " = call i8* @\"fray_int\"(i64 " + cur + ")")
        old_var = fresh_var(b)
        emit(b, "  " + old_var + " = load i8*, i8** " + var_alloca)
        emit(b, "  store i8* " + elem + ", i8** " + var_alloca)
        emit(b, "  call void @\"fray_release\"(i8* " + old_var + ")")
    for stmt in node["body"]:
        gen_stmt(b, stmt)
    if not is_terminated(b):
        emit(b, "  br label %" + preheader)
    emit(b, exit_label + ":")
    # Nothing to drop: the counted loop owns no list and no box.
    b.loop_break = old_break
    b.loop_continue = old_cont

def gen_for(b, node):
    old_break = b.loop_break
    old_cont = b.loop_continue
    # `for i in range(...)` is a counted loop, not a sequence: it never builds
    # the list, and with a machine slot for the loop variable it never boxes an
    # element. Arity outside 1..3 keeps the generic path, which reports the
    # same "range() takes at most 3 arguments" the call site does.
    if is_range_call(node["iterable"]):
        nargs = len(node["iterable"]["args"])
        if nargs >= 1 and nargs <= 3:
            if range_step_value(node["iterable"]) != 0:
                gen_for_range(b, node)
                return
    iter_val = gen_expr(b, node["iterable"])
    # Iterating a map walks its keys, in insertion order — the oracle and the
    # bootstrap's compiled path both do that, and this loop did not: it handed
    # a map to the list accessor, so the program compiled and then died at run
    # time with "TypeError: not a list". The runtime is dynamically typed, so
    # dispatch on the value's tag at loop entry, as INDEX_ACCESS already does.
    tag_byte = fresh_var(b)
    emit(b, "  " + tag_byte + " = load i8, i8* " + iter_val)
    is_map = fresh_var(b)
    emit(b, "  " + is_map + " = icmp eq i8 " + tag_byte + ", " + str(TAG_MAP))
    map_block = fresh_block(b, "for_iter_map")
    seq_block = fresh_block(b, "for_iter_seq")
    iter_merge = fresh_block(b, "for_iter_merge")
    emit(b, "  br i1 " + is_map + ", label %" + map_block + ", label %" + seq_block)
    emit(b, map_block + ":")
    keys_val = fresh_var(b)
    emit(b, "  " + keys_val + " = call i8* @\"fray_map_keys\"(i8* " + iter_val + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + iter_val + ")")
    emit(b, "  br label %" + iter_merge)
    emit(b, seq_block + ":")
    emit(b, "  br label %" + iter_merge)
    emit(b, iter_merge + ":")
    iter_seq = fresh_var(b)
    emit(b, "  " + iter_seq + " = phi i8* [" + keys_val + ", %" + map_block + "], [" + iter_val + ", %" + seq_block + "]")
    len_val = fresh_var(b)
    emit(b, "  " + len_val + " = call i8* @\"fray_len\"(i8* " + iter_seq + ")")
    len_i64 = fresh_var(b)
    emit(b, "  " + len_i64 + " = call i64 @\"fray_as_int\"(i8* " + len_val + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + len_val + ")")
    # A fresh name, not "%<var>_idx": two loops over the same variable in one
    # function would otherwise declare the same local twice (invalid IR).
    idx_alloca = fresh_var(b)
    emit(b, "  " + idx_alloca + " = alloca i64")
    emit(b, "  store i64 0, i64* " + idx_alloca)
    var_name = node["var"]
    var_alloca = for_var_slot(b, node)
    preheader = fresh_block(b, "for_preheader")
    body_label = fresh_block(b, "for_body")
    exit_label = fresh_block(b, "for_exit")
    cont_label = fresh_block(b, "for_cont")
    b.loop_break = exit_label
    b.loop_continue = cont_label
    emit(b, "  br label %" + preheader)
    emit(b, preheader + ":")
    idx_load = fresh_var(b)
    emit(b, "  " + idx_load + " = load i64, i64* " + idx_alloca)
    cmp = fresh_var(b)
    emit(b, "  " + cmp + " = icmp slt i64 " + idx_load + ", " + len_i64)
    emit(b, "  br i1 " + cmp + ", label %" + body_label + ", label %" + exit_label)
    emit(b, body_label + ":")
    idx_cur = fresh_var(b)
    emit(b, "  " + idx_cur + " = load i64, i64* " + idx_alloca)
    elem = fresh_var(b)
    emit(b, "  " + elem + " = call i8* @\"fray_list_index\"(i8* " + iter_seq + ", i64 " + idx_cur + ")")
    # The loop variable's slot belongs to this frame — an ordinary local, or
    # (unusually) a parameter: drop the previous iteration's value before
    # storing this one. A machine slot owns nothing, so its element is simply
    # unwrapped (the element boxes themselves still come from the list, which
    # is what a `for` over a sequence still pays for; a `for` over a range does
    # not, see gen_for_range).
    if var_alloca == null:
        el = fresh_var(b)
        emit(b, "  " + el + " = call " + raw_ty(b.slot_kinds[var_name]) + " @\"fray_as_" + unbox_name(b.slot_kinds[var_name]) + "\"(i8* " + elem + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + elem + ")")
        store_raw(b, var_name, el)
    else:
        old_var = fresh_var(b)
        emit(b, "  " + old_var + " = load i8*, i8** " + var_alloca)
        emit(b, "  store i8* " + elem + ", i8** " + var_alloca)
        emit(b, "  call void @\"fray_release\"(i8* " + old_var + ")")
    for stmt in node["body"]:
        gen_stmt(b, stmt)
    # Continue target: the index increment block
    if not is_terminated(b):
        emit(b, "  br label %" + cont_label)
    emit(b, cont_label + ":")
    idx_next = fresh_var(b)
    emit(b, "  " + idx_next + " = load i64, i64* " + idx_alloca)
    idx_incr = fresh_var(b)
    emit(b, "  " + idx_incr + " = add i64 " + idx_next + ", 1")
    emit(b, "  store i64 " + idx_incr + ", i64* " + idx_alloca)
    emit(b, "  br label %" + preheader)
    emit(b, exit_label + ":")
    # The loop owns the reference it iterated: gen_expr returned an owned value
    # and the map path replaced it with an owned keys list. Releasing it here
    # covers both the natural exit and `break`, which branches to this label.
    emit(b, "  call void @\"fray_release\"(i8* " + iter_seq + ")")
    b.loop_break = old_break
    b.loop_continue = old_cont


def gen_slot_release(b, slots):
    # Drop the frame's remaining owned references immediately before a return.
    # Every local slot holds a reference it owns (assignment releases the old
    # value and stores the new one), and until this ran nothing ever dropped the
    # last one: a `return` left the frame's values behind, which the ASan gate
    # saw as one box per boxed local per call. The value being returned is not
    # affected: gen_expr hands back a reference of its own, so the object
    # survives even when the slot that held it is dropped here.
    i = 0
    while i < len(slots):
        slot = slots[i]
        v = fresh_var(b)
        emit(b, "  " + v + " = load i8*, i8** " + slot)
        emit(b, "  call void @\"fray_release\"(i8* " + v + ")")
        emit(b, "  store i8* null, i8** " + slot)
        i = i + 1


def gen_return_value(b, val):
    # The value a return hands back: the expression's result, or a fresh None
    # when the return has none. A helper because the two callers below are in
    # different branches, and a local declared in one branch is not visible from
    # the other.
    if val != null:
        return gen_expr(b, val)
    none = fresh_var(b)
    emit(b, "  " + none + " = call i8* @\"fray_none\"()")
    return none


def gen_deferred_return(b, rv):
    # The return path of a `return` inside a try body (b.try_* is set).
    #
    # `try: return a / b` must not hand back a placeholder just because the
    # division failed: the runtime's pending exception is what decides, and the
    # oracle lets the matching clause win. So the pending flag is read here,
    # before anything is returned:
    #
    #   * an exception is pending — the return is abandoned. The value it built
    #     is dropped (it was ours, and nobody will own it now) and control joins
    #     the try's clause dispatch, which runs the clause that matches, or the
    #     finally that hands the exception on.
    #   * nothing is pending — the value waits in the try's park slot while the
    #     finally body runs, and the try's tail returns it. Running the finally
    #     first is what the oracle does: `try: return x` with a finally prints
    #     the finally's output before the caller sees anything.
    exc_ptr = fresh_var(b)
    emit(b, "  " + exc_ptr + " = call i32* @\"fray_exc_type\"()")
    exc_loaded = fresh_var(b)
    emit(b, "  " + exc_loaded + " = load i32, i32* " + exc_ptr)
    has_exc = fresh_var(b)
    emit(b, "  " + has_exc + " = icmp ne i32 " + exc_loaded + ", 0")
    throw_block = fresh_block(b, "try_ret_throw")
    park_block = fresh_block(b, "try_ret_park")
    emit(b, "  br i1 " + has_exc + ", label %" + throw_block + ", label %" + park_block)
    emit(b, throw_block + ":")
    emit(b, "  call void @\"fray_release\"(i8* " + rv + ")")
    emit(b, "  br label %" + b.try_dispatch)
    emit(b, park_block + ":")
    emit(b, "  store i8* " + rv + ", i8** " + b.try_park)
    emit(b, "  store i1 1, i1* " + b.try_flag)
    emit(b, "  br label %" + b.try_finally)


def gen_func_def(b, node):
    name = node["name"]
    params = node["params"]
    b.func_counter = b.func_counter + 1
    saved_vars = {}
    for k in b.func_vars:
        saved_vars[k] = b.func_vars[k]
    saved_counter = b.var_counter
    saved_block = b.current_block_name
    saved_in_func = b.in_func
    saved_slots = b.ret_slots
    saved_in_async = b.in_async
    saved_ret_i8 = b.ret_i8
    b.ret_i8 = 1
    # A function body does not inherit the try of the statement that defines
    # it: a `return` in here must not unwind through the enclosing try's
    # finally, and its park slot does not exist in this frame at all.
    saved_try_dispatch = b.try_dispatch
    saved_try_finally = b.try_finally
    saved_try_park = b.try_park
    saved_try_flag = b.try_flag
    saved_cur_fn = b.cur_fn
    saved_var_tys = b.var_tys
    saved_slot_kinds = b.slot_kinds
    saved_raw_vars = b.raw_vars
    b.func_vars = {}
    b.ret_slots = []
    b.var_counter = -1
    b.in_func = True
    # This frame's machine slots: the types the inference pass proved for this
    # function's names, and the subset of them that gets a raw alloca. The env
    # is the inference pass's own table, read-only from here on (expr_ty only
    # ever reads it).
    b.raw_vars = {}
    b.var_tys = {}
    b.cur_fn = name
    if b.infer != null and name in b.infer.envs:
        b.var_tys = b.infer.envs[name]
    b.slot_kinds = decide_slots(b, node)
    # A plain function body never suspends: `await` inside it is rejected by
    # gen_expr however deeply the enclosing async body wrapped it.
    b.in_async = 0
    b.try_dispatch = ""
    b.try_finally = ""
    b.try_park = ""
    b.try_flag = ""
    param_types = ""
    pj = 0
    while pj < len(params):
        if pj > 0:
            param_types = param_types + ", "
        param_types = param_types + "i8* %p" + str(pj)
        pj = pj + 1
    emit(b, "define i8* @\"" + name + "\"(" + param_types + ") {")
    entry = fresh_block(b, "entry")
    emit(b, entry + ":")
    b.current_block_name = entry
    i = 0
    while i < len(params):
        p = params[i]
        param_val = "%p" + str(i)
        if p in b.slot_kinds:
            # A parameter the call sites all agree is an int (or a float)
            # lives in a machine slot: the box is unwrapped here and dropped
            # at once, so nothing carries a reference into the body.
            declare_raw(b, p, b.slot_kinds[p])
            store_raw_param(b, p, b.slot_kinds[p], param_val)
        else:
            alloca = "%" + p
            emit(b, "  " + alloca + " = alloca i8*")
            emit(b, "  store i8* " + param_val + ", i8** " + alloca)
            b.func_vars[p] = alloca
        # Parameters are owned, exactly like every other boxed local: the
        # caller hands the reference over and does not release it after the
        # call, and this frame drops the slot on the way out (see ret_slots
        # below). The convention used to be the opposite — the caller released
        # each argument and the parameter slot was left out of ret_slots — so
        # rebinding one (`lo = hi`) stored an owned reference into a slot that
        # nothing ever dropped: one box leaked on every such call. A machine
        # slot owns nothing, which is why the release above is the last one
        # the argument sees.
        i = i + 1
    nested = collect_func_locals(node["body"], b.global_vars)
    for k in nested:
        pname = k
        if pname in b.slot_kinds:
            # Every local the inference pass proved, not just the ones first
            # assigned inside a loop: the slot has to exist before the body
            # so that the alloca dominates every use of it. A parameter that
            # is also assigned in the body is in this list too, and its slot
            # is already there from the bind loop.
            if not (pname in b.raw_vars):
                declare_raw(b, pname, b.slot_kinds[pname])
        elif not (pname in b.func_vars):
            pa = "%" + pname
            emit(b, "  " + pa + " = alloca i8*")
            emit(b, "  store i8* null, i8** " + pa)
            b.func_vars[pname] = pa
    # The slots this frame owns: every alloca in the entry block, parameters
    # included (see the comment on the bind loop above). A return drops them
    # all, which is what makes a rebound — or simply unused — parameter stop
    # at the frame boundary instead of leaking.
    ret_slots = []
    for k in b.func_vars:
        ret_slots.append(b.func_vars[k])
    b.ret_slots = ret_slots
    for stmt in node["body"]:
        gen_stmt(b, stmt)
    if not b.lines[len(b.lines) - 1].startswith("  ret "):
        gen_slot_release(b, b.ret_slots)
        none = fresh_var(b)
        emit(b, "  " + none + " = call i8* @\"fray_none\"()")
        emit(b, "  ret i8* " + none)
    emit(b, "}")
    emit(b, "")
    b.func_vars = saved_vars
    b.ret_slots = saved_slots
    b.var_counter = saved_counter
    b.current_block_name = saved_block
    b.in_func = saved_in_func
    b.in_async = saved_in_async
    b.ret_i8 = saved_ret_i8
    b.try_dispatch = saved_try_dispatch
    b.try_finally = saved_try_finally
    b.try_park = saved_try_park
    b.try_flag = saved_try_flag
    b.cur_fn = saved_cur_fn
    b.var_tys = saved_var_tys
    b.slot_kinds = saved_slot_kinds
    b.raw_vars = saved_raw_vars


def gen_async_func_def(b, node):
    # Async functions (Phase 7).
    # The callable entry point is a void trampoline
    # with the shape the runtime's coroutine invokes through the function
    # object's code pointer:
    #
    #   define void @"fray_async.<name>"(i8* %self_fn) {
    #     %argv = call i8* @"fray_coro_argv"()      ; the coroutine's args
    #     %res  = call i8* @"fray_async_body.<name>"(i8* %argv)
    #     call void @"fray_coro_result_store"(i8* %res)
    #     ret void
    #   }
    #
    # The body is an ordinary i8*-returning function (so RETURN_STMT needs no
    # special case) whose parameters are unpacked from that list — the
    # coroutine handle itself carries no arguments. It runs with in_async set,
    # which is what allows `await` inside it.
    name = node["name"]
    params = node["params"]
    b.func_counter = b.func_counter + 1
    saved_vars = {}
    for k in b.func_vars:
        saved_vars[k] = b.func_vars[k]
    saved_counter = b.var_counter
    saved_block = b.current_block_name
    saved_in_func = b.in_func
    saved_slots = b.ret_slots
    saved_in_async = b.in_async
    saved_ret_i8 = b.ret_i8
    saved_try_dispatch = b.try_dispatch
    saved_try_finally = b.try_finally
    saved_try_park = b.try_park
    saved_try_flag = b.try_flag
    saved_cur_fn = b.cur_fn
    saved_var_tys = b.var_tys
    saved_slot_kinds = b.slot_kinds
    saved_raw_vars = b.raw_vars
    b.func_vars = {}
    b.ret_slots = []
    b.var_counter = -1
    b.in_func = True
    b.in_async = 0
    b.ret_i8 = 1
    # No machine slots in a coroutine body: the same conservatism the
    # bootstrap keeps for an async function's parameters, and it keeps a
    # frame that suspends at an `await` from having to reason about what a
    # machine slot holds on the other side of the suspension.
    b.raw_vars = {}
    b.var_tys = {}
    b.slot_kinds = {}
    b.try_dispatch = ""
    b.try_finally = ""
    b.try_park = ""
    b.try_flag = ""
    emit(b, "define void @\"fray_async." + name + "\"(i8* %self_fn) {")
    tramp_entry = fresh_block(b, "entry_async")
    emit(b, tramp_entry + ":")
    b.current_block_name = tramp_entry
    argv = fresh_var(b)
    emit(b, "  " + argv + " = call i8* @\"fray_coro_argv\"()")
    res = fresh_var(b)
    emit(b, "  " + res + " = call i8* @\"fray_async_body." + name + "\"(i8* " + argv + ")")
    emit(b, "  call void @\"fray_coro_result_store\"(i8* " + res + ")")
    emit(b, "  ret void")
    emit(b, "}")
    emit(b, "")
    # The body: its own numbering, its own parameter slots, awaits allowed.
    b.var_counter = -1
    b.func_vars = {}
    b.in_async = 1
    b.try_dispatch = ""
    b.try_finally = ""
    b.try_park = ""
    b.try_flag = ""
    emit(b, "define i8* @\"fray_async_body." + name + "\"(i8* %argv) {")
    entry = fresh_block(b, "entry_async_body")
    emit(b, entry + ":")
    b.current_block_name = entry
    i = 0
    while i < len(params):
        p = params[i]
        alloca = "%" + p
        emit(b, "  " + alloca + " = alloca i8*")
        elem = fresh_var(b)
        emit(b, "  " + elem + " = call i8* @\"fray_list_index\"(i8* %argv, i64 " + str(i) + ")")
        emit(b, "  store i8* " + elem + ", i8** " + alloca)
        # fray_list_index hands back an owned reference and this body owns its
        # parameters just as a plain function does: the slot keeps that
        # reference and the return path (ret_slots below) drops it. The
        # coroutine's argument list holds a reference of its own for the
        # body's lifetime, so this one is a separate reference, not the list's.
        b.func_vars[p] = alloca
        i = i + 1
    nested = collect_func_locals(node["body"], b.global_vars)
    for k in nested:
        pname = k
        if not (pname in b.func_vars):
            pa = "%" + pname
            emit(b, "  " + pa + " = alloca i8*")
            emit(b, "  store i8* null, i8** " + pa)
            b.func_vars[pname] = pa
    # Same frame contract as a plain function body: every entry-block slot this
    # body owns — parameters included — is what a return has to drop.
    ret_slots = []
    for k in b.func_vars:
        ret_slots.append(b.func_vars[k])
    b.ret_slots = ret_slots
    for stmt in node["body"]:
        gen_stmt(b, stmt)
    if not b.lines[len(b.lines) - 1].startswith("  ret "):
        gen_slot_release(b, b.ret_slots)
        none = fresh_var(b)
        emit(b, "  " + none + " = call i8* @\"fray_none\"()")
        emit(b, "  ret i8* " + none)
    emit(b, "}")
    emit(b, "")
    b.func_vars = saved_vars
    b.ret_slots = saved_slots
    b.var_counter = saved_counter
    b.current_block_name = saved_block
    b.in_func = saved_in_func
    b.in_async = saved_in_async
    b.ret_i8 = saved_ret_i8
    b.try_dispatch = saved_try_dispatch
    b.try_finally = saved_try_finally
    b.try_park = saved_try_park
    b.try_flag = saved_try_flag
    b.cur_fn = saved_cur_fn
    b.var_tys = saved_var_tys
    b.slot_kinds = saved_slot_kinds
    b.raw_vars = saved_raw_vars

# ─── Variable pre-declaration ───

# ─── Struct / Enum / Match / Try / Del / Break / Extern ───

def gen_struct_def(b, node):
    # Register struct definition — no runtime code emitted
    b.struct_defs[node["name"]] = node["fields"]

def gen_enum_def(b, node):
    # Register enum definition — each variant is a struct with _variant tag,
    # the enum's own name in _enum, and the flattened params. _enum is what a
    # qualified match arm is checked against (gen_match): the oracle matches
    # `case Shape.Circle(r):` only when the subject's enum definition *is*
    # Shape, and a struct's field names are its only per-instance type
    # identity in v1 (fray_struct_new keeps no name — see runtime/structs.c).
    cases = node["cases"]
    all_fields = ["_variant", "_enum"]
    i = 0
    while i < len(cases):
        c = cases[i]
        j = 0
        while j < len(c["params"]):
            p = c["params"][j]
            found = False
            k = 0
            while k < len(all_fields):
                if all_fields[k] == p:
                    found = True
                k = k + 1
            if not found:
                all_fields.append(p)
            j = j + 1
        i = i + 1
    b.enum_defs[node["name"]] = {"cases": cases, "fields": all_fields}

def find_enum_variant(enum_defs, name):
    # Search all enum defs for a variant with the given name
    # Returns (enum_name, variant_info) or (null, null)
    for ename in enum_defs:
        einfo = enum_defs[ename]
        j = 0
        while j < len(einfo["cases"]):
            if einfo["cases"][j]["name"] == name:
                return (ename, einfo["cases"][j])
            j = j + 1
    return (null, null)


def gen_enum_new(b, enum_name, enum_info, variant_name, args):
    # Create an enum variant instance using fray_struct_new with global field arrays
    # Sets _variant tag and binds positional args to the variant's params.
    all_fields = enum_info["fields"]
    # Build global field name arrays (like Python codegen does)
    arr_key = enum_name + ".fields"
    if not (arr_key in b.struct_defs):
        # Emit individual field name globals
        fi = 0
        while fi < len(all_fields):
            gname = ".enum_field." + enum_name + "." + all_fields[fi]
            fdata = all_fields[fi] + "\0"
            flen = len(fdata)
            encoded = encode_string(all_fields[fi])
            byte_str = "i8 " + encoded[0]
            ej = 1
            while ej < len(encoded):
                byte_str = byte_str + ", i8 " + encoded[ej]
                ej = ej + 1
            emit_global(b, "@\"" + gname + "\" = internal constant [" + str(len(encoded)) + " x i8] [" + byte_str + "]")
            fi = fi + 1
        # Emit pointer array
        arr_name = ".enum_fields." + enum_name
        ptr_str = ""
        fi = 0
        while fi < len(all_fields):
            if fi > 0:
                ptr_str = ptr_str + ", "
            gname = ".enum_field." + enum_name + "." + all_fields[fi]
            flen = len(all_fields[fi]) + 1
            # Each element of this [N x i8*] array is a pointer to a
            # [flen x i8] constant, so the element needs an explicit bitcast:
            # LLVM's typed-pointer parser (llvm-14's llc) rejects the bare
            # `[flen x i8]*` in an i8*-typed slot. llvmlite's LLVM (22) folded
            # every pointer type into `ptr` and accepted it, which is why this
            # only showed up under `llc`.
            ptr_str = ptr_str + "i8* bitcast ([" + str(flen) + " x i8]* @\"" + gname + "\" to i8*)"
            fi = fi + 1
        emit_global(b, "@\"" + arr_name + "\" = internal constant [" + str(len(all_fields)) + " x i8*] [" + ptr_str + "]")
        b.struct_defs[arr_key] = True
    # Call fray_struct_new(name, nfields, field_names_ptr)
    name_str = fresh_var(b)
    ref = string_const_ref(b, enum_name)
    emit(b, "  " + name_str + " = " + ref)
    arr_name2 = ".enum_fields." + enum_name
    arr_ptr = fresh_var(b)
    emit(b, "  " + arr_ptr + " = bitcast [" + str(len(all_fields)) + " x i8*]* @\"" + arr_name2 + "\" to i8*")
    sv = fresh_var(b)
    emit(b, "  " + sv + " = call i8* @\"fray_struct_new\"(i8* " + name_str + ", i64 " + str(len(all_fields)) + ", i8* " + arr_ptr + ")")
    # Set _variant field
    field_ptr = fresh_var(b)
    field_ref = string_const_ref(b, "_variant")
    emit(b, "  " + field_ptr + " = " + field_ref)
    val_ptr = fresh_var(b)
    val_ref = string_const_ref(b, variant_name)
    emit(b, "  " + val_ptr + " = " + val_ref)
    val_copy = fresh_var(b)
    emit(b, "  " + val_copy + " = call i8* @\"fray_string_copy\"(i8* " + val_ptr + ")")
    emit(b, "  call void @\"fray_struct_field_set\"(i8* " + sv + ", i8* " + field_ptr + ", i8* " + val_copy + ")")
    # Set _enum to the enum's name, the same way _variant is set. A qualified
    # match arm compares it to the enum the arm names, so sibling enums that
    # share a variant name stay distinct.
    enum_ptr = fresh_var(b)
    enum_name_ref = string_const_ref(b, "_enum")
    emit(b, "  " + enum_ptr + " = " + enum_name_ref)
    ename_ptr = fresh_var(b)
    ename_ref = string_const_ref(b, enum_name)
    emit(b, "  " + ename_ptr + " = " + ename_ref)
    ename_copy = fresh_var(b)
    emit(b, "  " + ename_copy + " = call i8* @\"fray_string_copy\"(i8* " + ename_ptr + ")")
    emit(b, "  call void @\"fray_struct_field_set\"(i8* " + sv + ", i8* " + enum_ptr + ", i8* " + ename_copy + ")")
    # Bind positional args to the variant's params
    vparams = []
    ci = 0
    while ci < len(enum_info["cases"]):
        if enum_info["cases"][ci]["name"] == variant_name:
            vparams = enum_info["cases"][ci]["params"]
        ci = ci + 1
    ai = 0
    while ai < len(args) and ai < len(vparams):
        fs = fresh_var(b)
        fs_ref = string_const_ref(b, vparams[ai])
        emit(b, "  " + fs + " = " + fs_ref)
        emit(b, "  call void @\"fray_struct_field_set\"(i8* " + sv + ", i8* " + fs + ", i8* " + args[ai] + ")")
        ai = ai + 1
    return sv


def find_variant_fields(enum_defs, ename, vname):
    # The fields an arm's params bind to. A qualified arm names its enum
    # ("case Shape.Circle(r):") and takes that enum's variant fields — an arm
    # whose qualifier names no enum, or a variant that enum does not have, can
    # never match and binds nothing. An unqualified arm ("case Circle(r):")
    # has only the variant name to go on, and the oracle resolves it against
    # whatever the subject is at run time; with no subject type to lean on,
    # one of the enums that declares the variant is as good as a static
    # lookup gets (plan.md, divergence 12).
    actual_fields = []
    if ename != "":
        if ename in enum_defs:
            cases = enum_defs[ename]["cases"]
            j = 0
            while j < len(cases):
                if cases[j]["name"] == vname:
                    actual_fields = cases[j]["params"]
                j = j + 1
    else:
        for e in enum_defs:
            cases = enum_defs[e]["cases"]
            j = 0
            while j < len(cases):
                if cases[j]["name"] == vname:
                    actual_fields = cases[j]["params"]
                j = j + 1
    return actual_fields


def bind_match_params(b, subject, arm, actual_fields, fresh_slots):
    # Bind match arm params as local variables. A param whose name the
    # enclosing frame did not pre-declare gets a slot of its own in the arm's
    # block; that slot owns the reference fray_struct_field_get handed back, so
    # it is recorded in fresh_slots and dropped when the arm ends (gen_match).
    # A name the frame *did* pre-declare (a local of the enclosing function, or
    # a module-level slot) is bound in place and left to the frame's own
    # release — its slot is already covered by the return path or the module
    # teardown.
    j = 0
    while j < len(arm["params"]):
        pname = arm["params"][j]
        field_name = pname
        if j < len(actual_fields):
            field_name = actual_fields[j]
        field_str = fresh_var(b)
        ref = string_const_ref(b, field_name)
        emit(b, "  " + field_str + " = " + ref)
        pval = fresh_var(b)
        emit(b, "  " + pval + " = call i8* @\"fray_struct_field_get\"(i8* " + subject + ", i8* " + field_str + ")")
        pname_alloca = "%" + pname
        is_new = False
        if not (pname in b.func_vars):
            emit(b, "  " + pname_alloca + " = alloca i8*")
            emit(b, "  store i8* null, i8** " + pname_alloca)
            b.func_vars[pname] = pname_alloca
            is_new = True
            fresh_slots.append(pname_alloca)
        else:
            pname_alloca = b.func_vars[pname]
        if not is_new:
            # In-place rebind of a slot the frame owns — a local or a
            # parameter: release what was there, then store the new binding.
            old_val = fresh_var(b)
            emit(b, "  " + old_val + " = load i8*, i8** " + pname_alloca)
            emit(b, "  store i8* " + pval + ", i8** " + pname_alloca)
            emit(b, "  call void @\"fray_release\"(i8* " + old_val + ")")
        else:
            emit(b, "  store i8* " + pval + ", i8** " + pname_alloca)
        j = j + 1


def gen_arm_body(b, body, ret_alloca):
    # Generate match arm statements. If the last statement is an
    # expression statement, its value becomes the arm result: it is
    # evaluated once and stored into the result alloca (ownership moves
    # to the alloca) instead of being emitted as a discarded statement.
    n = len(body)
    j = 0
    while j < n:
        stmt = body[j]
        if j == n - 1 and node_type(stmt) == "EXPR_STMT":
            val = gen_expr(b, stmt["expr"])
            emit(b, "  store i8* " + val + ", i8** " + ret_alloca)
        else:
            gen_stmt(b, stmt)
        j = j + 1

def gen_match(b, node):
    # Match expression — tag dispatch on enum _variant field, and on _enum for
    # an arm that names its enum ("case Shape.Circle(r):"), which the oracle
    # only lets match an instance of that enum.
    subject = gen_expr(b, node["subject"])
    # Result alloca — created in the current block so it dominates the
    # merge block where it is stored/loaded. A named value, not a numbered
    # temporary: see fresh_name.
    ret_alloca = fresh_name(b, "mr")
    emit(b, "  " + ret_alloca + " = alloca i8*")
    emit(b, "  store i8* null, i8** " + ret_alloca)
    variant_str = fresh_var(b)
    ref = string_const_ref(b, "_variant")
    emit(b, "  " + variant_str + " = " + ref)
    variant_val = fresh_var(b)
    emit(b, "  " + variant_val + " = call i8* @\"fray_struct_field_get\"(i8* " + subject + ", i8* " + variant_str + ")")
    merge_label = fresh_block(b, "match_merge")
    arms = node["arms"]
    i = 0
    while i < len(arms):
        arm = arms[i]
        variant_name = arm["variant_name"]
        actual_fields = find_variant_fields(b.enum_defs, arm["enum_name"], variant_name)
        arm_slots = []
        if variant_name == "_":
            # Wildcard — fall through from previous case
            bind_match_params(b, subject, arm, actual_fields, arm_slots)
            gen_arm_body(b, arm["body"], ret_alloca)
            if not is_terminated(b):
                # The arm's own bindings die with the arm: they hold the only
                # reference to the field values they pulled out of the subject.
                gen_slot_release(b, arm_slots)
                emit(b, "  br label %" + merge_label)
            i = i + 1
            continue
        # Named case — compare variant string
        case_label = fresh_block(b, "match_case")
        next_label = fresh_block(b, "match_next")
        case_str = fresh_var(b)
        ref3 = string_const_ref(b, variant_name)
        emit(b, "  " + case_str + " = " + ref3)
        vcp = fresh_var(b)
        emit(b, "  " + vcp + " = call i8* @\"fray_string_copy\"(i8* " + case_str + ")")
        cmp_val = fresh_var(b)
        emit(b, "  " + cmp_val + " = call i8* @\"fray_eq\"(i8* " + variant_val + ", i8* " + vcp + ")")
        cmp_bool = fresh_var(b)
        emit(b, "  " + cmp_bool + " = call i1 @\"fray_is_truthy\"(i8* " + cmp_val + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + cmp_val + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + vcp + ")")
        # A qualified arm also has to be the named enum, not merely a
        # same-named variant of some other enum. _enum carries the enum's
        # name (gen_enum_new), so both tests are string compares on the
        # subject.
        if arm["enum_name"] != "":
            enum_field = fresh_var(b)
            enum_field_ref = string_const_ref(b, "_enum")
            emit(b, "  " + enum_field + " = " + enum_field_ref)
            subject_enum = fresh_var(b)
            emit(b, "  " + subject_enum + " = call i8* @\"fray_struct_field_get\"(i8* " + subject + ", i8* " + enum_field + ")")
            qual_str = fresh_var(b)
            qual_ref = string_const_ref(b, arm["enum_name"])
            emit(b, "  " + qual_str + " = " + qual_ref)
            qual_copy = fresh_var(b)
            emit(b, "  " + qual_copy + " = call i8* @\"fray_string_copy\"(i8* " + qual_str + ")")
            enum_cmp = fresh_var(b)
            emit(b, "  " + enum_cmp + " = call i8* @\"fray_eq\"(i8* " + subject_enum + ", i8* " + qual_copy + ")")
            enum_bool = fresh_var(b)
            emit(b, "  " + enum_bool + " = call i1 @\"fray_is_truthy\"(i8* " + enum_cmp + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + enum_cmp + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + qual_copy + ")")
            emit(b, "  call void @\"fray_release\"(i8* " + subject_enum + ")")
            both = fresh_var(b)
            emit(b, "  " + both + " = and i1 " + cmp_bool + ", " + enum_bool)
            cmp_bool = both
        emit(b, "  br i1 " + cmp_bool + ", label %" + case_label + ", label %" + next_label)
        emit(b, case_label + ":")
        bind_match_params(b, subject, arm, actual_fields, arm_slots)
        gen_arm_body(b, arm["body"], ret_alloca)
        if not is_terminated(b):
            gen_slot_release(b, arm_slots)
            emit(b, "  br label %" + merge_label)
        emit(b, next_label + ":")
        i = i + 1
    # Terminate final fallthrough block
    if not b.lines[len(b.lines) - 1].startswith("  ret ") and not b.lines[len(b.lines) - 1].startswith("  br "):
        emit(b, "  br label %" + merge_label)
    emit(b, merge_label + ":")
    emit(b, "  call void @\"fray_release\"(i8* " + variant_val + ")")
    emit(b, "  call void @\"fray_release\"(i8* " + subject + ")")
    ret_val = fresh_var(b)
    emit(b, "  " + ret_val + " = load i8*, i8** " + ret_alloca)
    return ret_val

def gen_exc_match(b, expected, exc_loaded):
    # Test for one `except` clause, built in the block the emitter is in.
    # expected is the clause's exception id, -1 for a clause that catches what
    # the oracle can name, or 0 for one that can never match. Returns an i1
    # value's name, or "" when the clause is unreachable.
    if expected == 0:
        return ""
    if expected == -1:
        # `except:` / Exception / RuntimeError take the five types the oracle
        # can name and only those: a KeyError passes a bare `except:` there
        # too, so the test is a membership check, not "any exception".
        CATCHABLE = [1, 2, 3, 4, 5]
        test = ""
        i = 0
        while i < len(CATCHABLE):
            match_val = fresh_var(b)
            emit(b, "  " + match_val + " = icmp eq i32 " + exc_loaded + ", " + str(CATCHABLE[i]))
            if test == "":
                test = match_val
            else:
                or_val = fresh_var(b)
                emit(b, "  " + or_val + " = or i1 " + test + ", " + match_val)
                test = or_val
            i = i + 1
        return test
    match_val = fresh_var(b)
    emit(b, "  " + match_val + " = icmp eq i32 " + exc_loaded + ", " + str(expected))
    return match_val

def gen_try(b, node):
    # Try/except/finally, matching the bootstrap emitter: the runtime keeps one
    # pending exception per thread, a clause that matches clears it, and a
    # clause that does not leaves it pending for the finally to hand to the
    # enclosing try or, with none, out of the program.
    #
    # The body polls the flag after every statement, and a `return` in the body
    # polls it before returning too (gen_deferred_return): an exception left by
    # the statement that built the return value has to reach the matching
    # clause even when that statement is the one being returned from, which is
    # exactly what the oracle does. A return that survives the poll parks its
    # value in this try's slot, marks this try's flag, and leaves through the
    # finally; the tail below is what finally returns it.
    emit(b, "  call void @\"fray_try_begin\"()")
    dispatch_label = fresh_block(b, "try_dispatch")
    finally_label = fresh_block(b, "try_finally")
    end_label = fresh_block(b, "try_end")
    exc_type_ptr = fresh_var(b)
    emit(b, "  " + exc_type_ptr + " = call i32* @\"fray_exc_type\"()")
    # A `i8*`-returning body can park a return here and answer the pending
    # exception first; main (i32) has no result to hand back and keeps the
    # plain tail below.
    deferrable = b.ret_i8
    park_slot = ""
    ret_flag = ""
    outer_dispatch = ""
    outer_finally = ""
    outer_park = ""
    outer_flag = ""
    if deferrable == 1:
        # Where a `return` in the body parks its value, and whether one did. The
        # flag is cleared on entry: a try inside a loop is entered more than once.
        park_slot = fresh_name(b, "try_park")
        emit(b, "  " + park_slot + " = alloca i8*")
        ret_flag = fresh_name(b, "try_ret_flag")
        emit(b, "  " + ret_flag + " = alloca i1")
        emit(b, "  store i1 0, i1* " + ret_flag)
        # The try around this one, if any. A return unwinds through this try's
        # finally and then through the enclosing try's, in that order; both are
        # needed while the body is generated.
        outer_dispatch = b.try_dispatch
        outer_finally = b.try_finally
        outer_park = b.try_park
        outer_flag = b.try_flag
        b.try_dispatch = dispatch_label
        b.try_finally = finally_label
        b.try_park = park_slot
        b.try_flag = ret_flag
    # Generate try body statements with exception checks after each
    for stmt in node["body"]:
        gen_stmt(b, stmt)
        if is_terminated(b):
            # The statement ended the block — a return leaves through the
            # finally (or the dispatch), a break/continue through its loop — so
            # the rest of the body is unreachable and emitting it would put
            # instructions after a terminator.
            break
        # Check exception flag
        exc_loaded = fresh_var(b)
        emit(b, "  " + exc_loaded + " = load i32, i32* " + exc_type_ptr)
        has_exc = fresh_var(b)
        emit(b, "  " + has_exc + " = icmp ne i32 " + exc_loaded + ", 0")
        still_body = fresh_block(b, "try_body_next")
        emit(b, "  br i1 " + has_exc + ", label %" + dispatch_label + ", label %" + still_body)
        emit(b, still_body + ":")
    # The body is done. A `return` in an except clause does not end the try
    # either: this try's finally still has to run, and the caller still has to
    # see the value the clause produced. So the clause bodies keep this try's
    # park/flag/finally — but not its clause chain, because an exception raised
    # inside a handler belongs to the *enclosing* try, not to the clauses of the
    # try that is already handling it. The finally body below runs outside the
    # context: a `return` there would otherwise park its value and branch back
    # into its own finally.
    if deferrable == 1:
        b.try_dispatch = finally_label
        b.try_finally = finally_label
        b.try_park = park_slot
        b.try_flag = ret_flag
    else:
        b.try_dispatch = outer_dispatch
        b.try_finally = outer_finally
        b.try_park = outer_park
        b.try_flag = outer_flag
    # After all body stmts, if not terminated, go to finally
    if not is_terminated(b):
        emit(b, "  br label %" + finally_label)
    # Handler dispatch — a chain of tests, each in its own block so a failed
    # test falls to the next test, never into a handler body. Every body poll
    # and every abandoned return branches here.
    emit(b, dispatch_label + ":")
    exc_loaded2 = fresh_var(b)
    emit(b, "  " + exc_loaded2 + " = load i32, i32* " + exc_type_ptr)
    EXC_TYPE_MAP = {}
    EXC_TYPE_MAP["TypeError"] = 1
    EXC_TYPE_MAP["ValueError"] = 2
    EXC_TYPE_MAP["IndexError"] = 3
    EXC_TYPE_MAP["NameError"] = 4
    EXC_TYPE_MAP["ZeroDivisionError"] = 5
    handlers = node["except_clauses"]
    hi = 0
    while hi < len(handlers):
        handler = handlers[hi]
        handler_block = fresh_block(b, "exc_handler")
        exc_name = handler["type"]
        expected = 0
        if exc_name == null or exc_name == "Exception" or exc_name == "RuntimeError":
            expected = -1
        if exc_name != null and exc_name in EXC_TYPE_MAP:
            expected = EXC_TYPE_MAP[exc_name]
        test = gen_exc_match(b, expected, exc_loaded2)
        if test == "":
            # A clause that cannot match in the oracle either: nothing to
            # branch to, and the chain stays in this block
            hi = hi + 1
        else:
            next_handler = fresh_block(b, "exc_next")
            emit(b, "  br i1 " + test + ", label %" + handler_block + ", label %" + next_handler)
            emit(b, handler_block + ":")
            emit(b, "  call void @\"fray_exc_clear\"()")
            exc_name_var = handler["name"]
            if exc_name_var != null:
                exc_val = fresh_var(b)
                emit(b, "  " + exc_val + " = call i8* @\"fray_none\"()")
                if not (exc_name_var in b.func_vars):
                    ena = "%" + exc_name_var
                    emit(b, "  " + ena + " = alloca i8*")
                    b.func_vars[exc_name_var] = ena
                emit(b, "  store i8* " + exc_val + ", i8** " + b.func_vars[exc_name_var])
            for hstmt in handler["body"]:
                gen_stmt(b, hstmt)
            if not is_terminated(b):
                emit(b, "  br label %" + finally_label)
            emit(b, next_handler + ":")
            hi = hi + 1
    if deferrable == 1:
        b.try_dispatch = outer_dispatch
        b.try_finally = outer_finally
        b.try_park = outer_park
        b.try_flag = outer_flag
    # Nothing matched — the exception stays pending for the finally
    if not is_terminated(b):
        emit(b, "  br label %" + finally_label)
    # Finally block
    emit(b, finally_label + ":")
    emit(b, "  call void @\"fray_try_end\"()")
    if node["finally_body"] != null:
        for fstmt in node["finally_body"]:
            gen_stmt(b, fstmt)
    if not is_terminated(b):
        # Re-raise what no clause took (a no-op when one did, and a no-op again
        # for a return that is on its way out of this try)
        emit(b, "  call void @\"fray_exc_rethrow\"()")
        if deferrable == 0:
            emit(b, "  br label %" + end_label)
        else:
            ret_label = fresh_block(b, "try_return")
            flag_loaded = fresh_var(b)
            emit(b, "  " + flag_loaded + " = load i1, i1* " + ret_flag)
            emit(b, "  br i1 " + flag_loaded + ", label %" + ret_label + ", label %" + end_label)
            emit(b, ret_label + ":")
            ret_value = fresh_var(b)
            emit(b, "  " + ret_value + " = load i8*, i8** " + park_slot)
            if outer_finally != "":
                # A return has enclosing finally bodies left to run: hand it to
                # the try around this one and let that try's tail decide when
                # the function really returns. The frame's slots stay live until
                # then, so the enclosing finally can still read them.
                emit(b, "  store i8* " + ret_value + ", i8** " + outer_park)
                emit(b, "  store i1 1, i1* " + outer_flag)
                emit(b, "  br label %" + outer_finally)
            else:
                gen_slot_release(b, b.ret_slots)
                emit(b, "  ret i8* " + ret_value)
    emit(b, end_label + ":")

def gen_del(b, node):
    # del target
    target = node["target"]
    if node_type(target) == "INDEX_ACCESS":
        obj = gen_expr(b, target["obj"])
        key = gen_expr(b, target["index"])
        del_res = fresh_var(b)
        emit(b, "  " + del_res + " = call i8* @\"fray_map_del\"(i8* " + obj + ", i8* " + key + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + del_res + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + obj + ")")
        emit(b, "  call void @\"fray_release\"(i8* " + key + ")")
    elif node_type(target) == "IDENTIFIER":
        name = target["name"]
        if name in b.func_vars:
            old = fresh_var(b)
            emit(b, "  " + old + " = load i8*, i8** " + b.func_vars[name])
            none_val = fresh_var(b)
            emit(b, "  " + none_val + " = call i8* @\"fray_none\"()")
            emit(b, "  store i8* " + none_val + ", i8** " + b.func_vars[name])
            emit(b, "  call void @\"fray_release\"(i8* " + old + ")")
        else:
            old = fresh_var(b)
            emit(b, "  " + old + " = load i8*, i8** @\"" + name + "\"")
            none_val = fresh_var(b)
            emit(b, "  " + none_val + " = call i8* @\"fray_none\"()")
            emit(b, "  store i8* " + none_val + ", i8** @\"" + name + "\"")
            emit(b, "  call void @\"fray_release\"(i8* " + old + ")")

def extern_ty(type_name):
    # The LLVM type an `extern def` type name maps to. Both ends of the C ABI
    # go through this: the `declare` and the call site that unboxes into it.
    # An unrecognized name is an integer, which is also what the bootstrap's
    # table does.
    if type_name == "void":
        return "void"
    if type_name == "float" or type_name == "f64":
        return "double"
    if type_name == "f32":
        return "float"
    if type_name == "bool":
        return "i1"
    if type_name == "string" or type_name == "ptr":
        return "i8*"
    if type_name == "i32" or type_name == "u32":
        return "i32"
    if type_name == "i16" or type_name == "u16":
        return "i16"
    if type_name == "i8" or type_name == "u8" or type_name == "char":
        return "i8"
    return "i64"

def gen_extern(b, node):
    # Declare an external C function
    ret_type = extern_ty(node["return_type"])
    param_types_str = ""
    pt = node["param_types"]
    i = 0
    while i < len(pt):
        if i > 0:
            param_types_str = param_types_str + ", "
        param_types_str = param_types_str + extern_ty(pt[i])
        i = i + 1
    # Module level: a `declare` emitted where the statement appears would land
    # inside a function body, which LLVM rejects ("expected instruction opcode").
    emit_global(b, "declare " + ret_type + " @\"" + node["name"] + "\"(" + param_types_str + ")")

def gen_extern_call(b, node, fn_name, args):
    # Call a declared C function: unbox each argument to the type the
    # declaration promised, call it directly, and box the result back into a
    # fray value. Ownership follows the ordinary rule — the argument boxes this
    # call owns are released after the call, and the result is a fresh owned
    # reference.
    decl = b.extern_defs[fn_name]
    param_types = decl["param_types"]
    arg_str = ""
    i = 0
    while i < len(args):
        ptype = "i64"
        if i < len(param_types):
            ptype = extern_ty(param_types[i])
        raw = ""
        if ptype == "i8*":
            raw = fresh_var(b)
            emit(b, "  " + raw + " = call i8* @\"fray_as_string\"(i8* " + args[i] + ")")
        elif ptype == "double":
            raw = fresh_var(b)
            emit(b, "  " + raw + " = call double @\"fray_as_float\"(i8* " + args[i] + ")")
        elif ptype == "float":
            wide = fresh_var(b)
            emit(b, "  " + wide + " = call double @\"fray_as_float\"(i8* " + args[i] + ")")
            raw = fresh_var(b)
            emit(b, "  " + raw + " = fptrunc double " + wide + " to float")
        elif ptype == "i1":
            raw = fresh_var(b)
            emit(b, "  " + raw + " = call i1 @\"fray_is_truthy\"(i8* " + args[i] + ")")
        else:
            # An integer parameter: fray_as_int hands back i64, narrowed to the
            # declared width when the C side takes less than 64 bits.
            wide = fresh_var(b)
            emit(b, "  " + wide + " = call i64 @\"fray_as_int\"(i8* " + args[i] + ")")
            if ptype == "i32":
                raw = fresh_var(b)
                emit(b, "  " + raw + " = trunc i64 " + wide + " to i32")
            elif ptype == "i16":
                raw = fresh_var(b)
                emit(b, "  " + raw + " = trunc i64 " + wide + " to i16")
            elif ptype == "i8":
                raw = fresh_var(b)
                emit(b, "  " + raw + " = trunc i64 " + wide + " to i8")
            else:
                raw = wide
        if i > 0:
            arg_str = arg_str + ", "
        arg_str = arg_str + ptype + " " + raw
        i = i + 1
    ret = extern_ty(decl["return_type"])
    result = ""
    if ret == "void":
        emit(b, "  call void @\"" + fn_name + "\"(" + arg_str + ")")
    else:
        result = fresh_var(b)
        emit(b, "  " + result + " = call " + ret + " @\"" + fn_name + "\"(" + arg_str + ")")
    i = 0
    while i < len(args):
        emit(b, "  call void @\"fray_release\"(i8* " + args[i] + ")")
        i = i + 1
    if ret == "void":
        return gen_none(b)
    if ret == "i8*":
        # A `string` return is C memory, so it is copied into an owned fray
        # string. A `ptr` return is an integer handle to the program (the
        # bootstrap boxes it the same way).
        if decl["return_type"] == "string":
            v = fresh_var(b)
            emit(b, "  " + v + " = call i8* @\"fray_string_copy\"(i8* " + result + ")")
            return v
        v = fresh_var(b)
        emit(b, "  " + v + " = ptrtoint i8* " + result + " to i64")
        boxed = fresh_var(b)
        emit(b, "  " + boxed + " = call i8* @\"fray_int\"(i64 " + v + ")")
        return boxed
    if ret == "i1":
        v = fresh_var(b)
        emit(b, "  " + v + " = call i8* @\"fray_bool\"(i1 " + result + ")")
        return v
    if ret == "double":
        v = fresh_var(b)
        emit(b, "  " + v + " = call i8* @\"fray_float\"(double " + result + ")")
        return v
    if ret == "float":
        wide = fresh_var(b)
        emit(b, "  " + wide + " = fpext float " + result + " to double")
        v = fresh_var(b)
        emit(b, "  " + v + " = call i8* @\"fray_float\"(double " + wide + ")")
        return v
    # An integer return: widen to i64 before boxing.
    wide = result
    if ret != "i64":
        wide = fresh_var(b)
        emit(b, "  " + wide + " = sext " + ret + " " + result + " to i64")
    v = fresh_var(b)
    emit(b, "  " + v + " = call i8* @\"fray_int\"(i64 " + wide + ")")
    return v

def collect_func_locals(stmts, globals):
    # Every name this function assigns to anywhere in its body — collected by
    # the same walk that used to record only names first assigned inside
    # nested control flow. A local needs its alloca in the entry block (an
    # alloca created mid-block would not dominate uses after a branch), so
    # they are pre-declared here. A name that is a module global is *not* a
    # local: assigning it from a function writes the module variable, which is
    # what the oracle and the compiled bootstrap both do.
    names = {}
    _scan_body(stmts, names)
    locals = {}
    for k in names:
        if not (k in globals):
            locals[k] = True
    return locals


def collect_nested_vars(stmts):
    # Walk stmts and return variable names that are first assigned inside
    # nested control-flow at module level (loops, if-branches) — the names
    # main's frame must pre-declare. Function bodies are *not* descended into:
    # a function's locals live in that function's frame, and declaring them in
    # main's frame is both wasteful (thousands of dead allocas when compiling
    # this compiler) and how a local named `entry` once collided with main's
    # entry label. Function locals are collected by collect_func_locals.
    names = {}
    i = 0
    while i < len(stmts):
        s = stmts[i]
        nt = node_type(s)
        if nt == "WHILE_LOOP":
            _scan_body(s["body"], names)
        elif nt == "FOR_LOOP":
            names[s["var"]] = True
            _scan_body(s["body"], names)
        elif nt == "IF_STMT":
            _scan_body(s["body"], names)
            eb = node_get(s, "else_body", null)
            if eb != null:
                _scan_body(eb, names)
            branches = node_get(s, "elif_branches", [])
            j = 0
            while j < len(branches):
                br = branches[j]
                _scan_body(br["body"], names)
                j = j + 1
        elif nt == "TRY_STMT":
            _scan_body(s["body"], names)
            handlers = node_get(s, "except_clauses", [])
            j = 0
            while j < len(handlers):
                _scan_body(handlers[j]["body"], names)
                j = j + 1
            fb = node_get(s, "finally_body", null)
            if fb != null:
                _scan_body(fb, names)
        elif nt == "MATCH_EXPR":
            arms = node_get(s, "arms", [])
            j = 0
            while j < len(arms):
                # Arm params bind by name through func_vars, so they are
                # variables of the enclosing frame and their allocas must sit
                # in the entry block: a slot first created inside one match's
                # case block does not dominate a later match that reuses the
                # same param name ("Instruction does not dominate all uses").
                params = node_get(arms[j], "params", [])
                p = 0
                while p < len(params):
                    names[params[p]] = True
                    p = p + 1
                _scan_body(arms[j]["body"], names)
                j = j + 1
        i = i + 1
    return names

def _scan_body(body, names):
    # Scan a single block body for assignment targets and nested blocks
    i = 0
    while i < len(body):
        s = body[i]
        nt = node_type(s)
        if nt == "ASSIGNMENT":
            target = s["target"]
            if node_type(target) == "IDENTIFIER":
                names[target["name"]] = True
        elif nt == "AUG_ASSIGNMENT":
            target = s["target"]
            if node_type(target) == "IDENTIFIER":
                names[target["name"]] = True
        elif nt == "AUG_ASSIGNMENT":
            target = s["target"]
            if node_type(target) == "IDENTIFIER":
                names[target["name"]] = True
        elif nt == "WHILE_LOOP":
            _scan_body(s["body"], names)
        elif nt == "FOR_LOOP":
            names[s["var"]] = True
            _scan_body(s["body"], names)
        elif nt == "IF_STMT":
            _scan_body(s["body"], names)
            eb = node_get(s, "else_body", null)
            if eb != null:
                _scan_body(eb, names)
            branches = node_get(s, "elif_branches", [])
            j = 0
            while j < len(branches):
                br = branches[j]
                _scan_body(br["body"], names)
                j = j + 1
        elif nt == "FUNCTION_DEF":
            _scan_body(s["body"], names)
        elif nt == "TRY_STMT":
            _scan_body(s["body"], names)
            handlers = node_get(s, "except_clauses", [])
            j = 0
            while j < len(handlers):
                _scan_body(handlers[j]["body"], names)
                j = j + 1
            fb = node_get(s, "finally_body", null)
            if fb != null:
                _scan_body(fb, names)
        elif nt == "MATCH_EXPR":
            arms = node_get(s, "arms", [])
            j = 0
            while j < len(arms):
                # Arm params bind by name through func_vars, so they are
                # variables of the enclosing frame and their allocas must sit
                # in the entry block: a slot first created inside one match's
                # case block does not dominate a later match that reuses the
                # same param name ("Instruction does not dominate all uses").
                params = node_get(arms[j], "params", [])
                p = 0
                while p < len(params):
                    names[params[p]] = True
                    p = p + 1
                _scan_body(arms[j]["body"], names)
                j = j + 1
        i = i + 1

# ─── Main compilation entry ───

def compile_ir(program):
    # NOTE: the module carries no target triple or data layout at all, so LLVM
    # on each host fills in its own — the same emitted text builds a Linux,
    # macOS or Windows binary without the host editing it first.
    clear_errors()
    b = make_ir()
    emit(b, "; ModuleID = \"main\"")
    # No target triple and no data layout: the frontend is host-agnostic, and
    # every host's LLVM already knows its own defaults (llc, clang and the
    # llvmlite driver each fill them in). Pinning "x86_64-pc-windows-msvc" here
    # is what forced the host to rewrite the triple before emitting an object,
    # so that a .ll produced on Linux carried a Windows datalayout. The IR only
    # uses pointer/i64/double values, whose sizes are the same on every host
    # this toolchain targets, so the module is portable as text.
    emit(b, "; host-agnostic module: target triple and data layout come from LLVM")
    emit(b, "")
    emit_runtime_decls(b)
    emit(b, "")
    func_names = {}
    i = 0
    while i < len(program["body"]):
        stmt = program["body"][i]
        nt = node_type(stmt)
        if nt == "FUNCTION_DEF":
            func_names[stmt["name"]] = True
            b.func_arities[stmt["name"]] = len(stmt["params"])
            if node_get(stmt, "is_async", False):
                # An async function's user-visible entry point is the
                # coroutine trampoline fray_async.<name>, not <name>, so a
                # call site has to know which names are coroutines.
                b.async_fns[stmt["name"]] = True
        elif nt == "EXTERN_DECL":
            # Declared by the program: a call to it is unresolvable for a
            # different reason than a typo, so keep the two apart. The whole
            # declaration is kept too — a call site needs its parameter and
            # return types to unbox and box around the C ABI, and function
            # bodies are emitted after this pass.
            func_names[stmt["name"]] = True
            b.extern_names[stmt["name"]] = True
            b.extern_defs[stmt["name"]] = stmt
        i = i + 1
    b.func_names = func_names
    # What each function's locals are proven to be, decided once for the whole
    # module before any body is emitted: the answer must not depend on the order
    # the functions happen to be emitted in, because a body emitted earlier
    # would be reading a table a later one has not filled in yet. The globals
    # collected just above are part of the input — a name assigned at module
    # scope is a global, not a frame slot, so it can never be unboxed.
    b.infer = infer_program(program, b.global_vars)
    i = 0
    while i < len(program["body"]):
        stmt = program["body"][i]
        nt = node_type(stmt)
        if nt == "ASSIGNMENT" and node_type(stmt["target"]) == "IDENTIFIER":
            name = stmt["target"]["name"]
            if not (name in func_names) and not (name in b.global_vars):
                emit(b, "@\"" + name + "\" = global i8* null")
                b.global_vars[name] = True
        elif nt == "CONST_STMT":
            name = stmt["name"]
            if not (name in b.global_vars):
                emit(b, "@\"" + name + "\" = global i8* null")
                b.global_vars[name] = True
        i = i + 1
    # Register type definitions before any function is emitted. A function
    # body may construct a struct or an enum variant, and construction
    # resolves against b.struct_defs / b.enum_defs — but functions are emitted
    # before the module's own statements, so without this pass every
    # constructor inside a function was reported as "call to undefined
    # function". Registering is all it is: both generators only record names
    # and emit no IR, so doing it early costs nothing and the main pass below
    # re-records the same definitions harmlessly.
    i = 0
    while i < len(program["body"]):
        stmt = program["body"][i]
        nt = node_type(stmt)
        if nt == "STRUCT_DEF":
            gen_struct_def(b, stmt)
        elif nt == "ENUM_DEF":
            gen_enum_def(b, stmt)
        i = i + 1
    # Emit function definitions, each followed by the value wrapper a
    # first-class function object runs (see gen_value_wrapper).
    i = 0
    while i < len(program["body"]):
        stmt = program["body"][i]
        if node_type(stmt) == "FUNCTION_DEF":
            if node_get(stmt, "is_async", False):
                # An async function has no plain body and no value wrapper:
                # its callable entry point is the coroutine trampoline.
                gen_async_func_def(b, stmt)
            else:
                gen_func_def(b, stmt)
                gen_value_wrapper(b, stmt)
        i = i + 1
    # C main signature: the runtime's fray_init_args stores the command line
    # for progName()/programArgs() before any fray code runs (the bootstrap
    # emitter does the same). Its temporaries restart at %0 like every other
    # function's — see gen_value_wrapper for why that matters.
    b.var_counter = -1
    # main returns i32, not i8*: a `return` in a try body cannot be parked here
    # (see gen_try), which is why the flag path is only emitted for function
    # bodies. b.ret_i8 is 1 only inside gen_func_def / gen_async_func_def.
    b.ret_i8 = 0
    emit(b, "define i32 @\"main\"(i32 %argc, i8** %argv)")
    emit(b, "{")
    # Block labels and local values share one namespace in LLVM's IR text, so
    # a bare "entry:" collides with a module-level local named `entry`
    # ("multiple definition of local value named 'entry'") — which is exactly
    # what happened when compiling this compiler's own sources. Function
    # bodies already use a counter-suffixed label; main does too now.
    main_entry = fresh_block(b, "entry")
    emit(b, main_entry + ":")
    # The init call must live *inside* the entry block: emitting it before the
    # label would leave an unterminated implicit block and LLVM would reject
    # the module with "expected instruction opcode" at the label.
    emit(b, "  call void @\"fray_init_args\"(i32 %argc, i8** %argv)")
    b.current_block_name = main_entry
    b.in_func = True
    i = 0
    while i < len(program["body"]):
        stmt = program["body"][i]
        if node_type(stmt) == "FUNCTION_DEF":
            i = i + 1
            continue
        if node_type(stmt) == "ASSIGNMENT" and node_type(stmt["target"]) == "IDENTIFIER":
            name = stmt["target"]["name"]
            if not (name in b.global_vars):
                emit(b, "  %" + name + " = alloca i8*")
                emit(b, "  store i8* null, i8** %" + name + "")
                b.func_vars[name] = "%" + name
        i = i + 1
    # Pre-create allocas for variables first assigned inside nested blocks
    nested = collect_nested_vars(program["body"])
    for k in nested:
        name = k
        if not (name in b.func_vars) and not (name in b.global_vars):
            emit(b, "  %" + name + " = alloca i8*")
            emit(b, "  store i8* null, i8** %" + name + "")
            b.func_vars[name] = "%" + name
    # The slots that live in main's entry block — the module-level variables,
    # and the only ones the teardown below may touch. An alloca created later
    # (a match arm's parameter, for one) is scoped to the block that bound it,
    # so releasing it from the end of main is not just wrong, it does not even
    # verify: "Instruction does not dominate all uses!"
    mod_slots = []
    for k in b.func_vars:
        mod_slots.append(b.func_vars[k])
    i = 0
    while i < len(program["body"]):
        stmt = program["body"][i]
        if node_type(stmt) != "FUNCTION_DEF":
            gen_stmt(b, stmt)
        i = i + 1
    # Module teardown: every module-level slot owns its value (assignments
    # release the old one, and the first is stored into a null slot), so a
    # program that ends with live module variables leaves those references
    # behind — invisible in a short run, a leak under ASan. Mirrors the
    # bootstrap's _emit_module_teardown: release each slot and null it, skipped
    # while spawned threads are still running because they read the globals.
    if not b.lines[len(b.lines) - 1].startswith("  ret "):
        live = fresh_var(b)
        emit(b, "  " + live + " = call i32 @\"fray_thread_count\"()")
        idle = fresh_var(b)
        emit(b, "  " + idle + " = icmp eq i32 " + live + ", 0")
        rel_blk = fresh_block(b, "module_release")
        done_blk = fresh_block(b, "module_release_done")
        emit(b, "  br i1 " + idle + ", label %" + rel_blk + ", label %" + done_blk)
        emit(b, rel_blk + ":")
        for k in b.global_vars:
            gname = k
            gtmp = fresh_var(b)
            emit(b, "  " + gtmp + " = load i8*, i8** @\"" + gname + "\"")
            emit(b, "  call void @\"fray_release\"(i8* " + gtmp + ")")
            emit(b, "  store i8* null, i8** @\"" + gname + "\"")
        mi = 0
        while mi < len(mod_slots):
            mslot = mod_slots[mi]
            vtmp = fresh_var(b)
            emit(b, "  " + vtmp + " = load i8*, i8** " + mslot)
            emit(b, "  call void @\"fray_release\"(i8* " + vtmp + ")")
            emit(b, "  store i8* null, i8** " + mslot)
            mi = mi + 1
        emit(b, "  br label %" + done_blk)
        emit(b, done_blk + ":")
        emit(b, "  ret i32 0")
    emit(b, "}")
    emit(b, "")
    i = 0
    while i < len(b.string_encoded):
        encoded = b.string_encoded[i]
        if encoded != null:
            idx = i + 1
            byte_str = "i8 " + encoded[0]
            j = 1
            while j < len(encoded):
                byte_str = byte_str + ", i8 " + encoded[j]
                j = j + 1
            emit(b, "@\".str." + str(idx) + "\" = constant [" + str(len(encoded)) + " x i8] [" + byte_str + "]")
        i = i + 1
    i = 0
    while i < len(b.postamble):
        emit(b, b.postamble[i])
        i = i + 1
    result = ""
    i = 0
    while i < len(b.lines):
        result = result + b.lines[i] + "\n"
        i = i + 1
    return result
