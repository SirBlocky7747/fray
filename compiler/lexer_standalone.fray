# compiler/lexer_standalone.fray — Standalone test of the self-hosted lexer
# All code in one file (no imports needed)

# ─── Token types ───

enum TokenType:
    case INT_LIT
    case FLOAT_LIT
    case STRING_LIT
    case IDENT
    case DEF
    case RETURN
    case IF
    case ELIF
    case ELSE
    case FOR
    case IN
    case WHILE
    case TRY
    case EXCEPT
    case FINALLY
    case CONST
    case IMPORT
    case FROM
    case EXTERN
    case ASYNC
    case AWAIT
    case STRUCT
    case ENUM
    case CASE
    case MATCH
    case DEL
    case BREAK
    case CONTINUE
    case AND
    case OR
    case XOR
    case XNOR
    case NOT
    case TRUE
    case FALSE
    case NULL_LIT
    case ASSIGN
    case PLUS_ASSIGN
    case MINUS_ASSIGN
    case STAR_ASSIGN
    case SLASH_ASSIGN
    case EQ
    case NEQ
    case LT
    case GT
    case LTE
    case GTE
    case PLUS
    case MINUS
    case STAR
    case SLASH
    case DOUBLE_SLASH
    case PERCENT
    case POWER
    case LPAREN
    case RPAREN
    case LBRACKET
    case RBRACKET
    case LBRACE
    case RBRACE
    case COMMA
    case COLON
    case DOT
    case QUESTION
    case INDENT_TOK
    case DEDENT_TOK
    case NEWLINE_TOK
    case EOF_TOK

# ─── Token struct ───

struct Token:
    tt
    val
    line
    col

# ─── Lexer state ───

struct LexerState:
    src
    pos
    line
    col
    indent_stack
    tokens
    cur_ch

# ─── Character helpers (must be first!) ───

def lex_advance(lex):
    ch = lex.src[lex.pos]
    lex.pos = lex.pos + 1
    lex.col = lex.col + 1
    return ch

def lex_peek(lex, offset):
    idx = lex.pos + offset
    if idx < len(lex.src):
        return lex.src[idx]
    return ""

def lex_emit(lex, tt_name, val, line, col):
    tok = Token(tt_name, val, line, col)
    lex.tokens.append(tok)

# ─── Keyword lookup ───

KEYWORDS = {}
KEYWORDS["def"] = "DEF"
KEYWORDS["return"] = "RETURN"
KEYWORDS["if"] = "IF"
KEYWORDS["elif"] = "ELIF"
KEYWORDS["else"] = "ELSE"
KEYWORDS["for"] = "FOR"
KEYWORDS["in"] = "IN"
KEYWORDS["while"] = "WHILE"
KEYWORDS["try"] = "TRY"
KEYWORDS["except"] = "EXCEPT"
KEYWORDS["finally"] = "FINALLY"
KEYWORDS["const"] = "CONST"
KEYWORDS["import"] = "IMPORT"
KEYWORDS["from"] = "FROM"
KEYWORDS["extern"] = "EXTERN"
KEYWORDS["async"] = "ASYNC"
KEYWORDS["await"] = "AWAIT"
KEYWORDS["and"] = "AND"
KEYWORDS["or"] = "OR"
KEYWORDS["xor"] = "XOR"
KEYWORDS["xnor"] = "XNOR"
KEYWORDS["not"] = "NOT"
KEYWORDS["True"] = "TRUE"
KEYWORDS["False"] = "FALSE"
KEYWORDS["null"] = "NULL_LIT"
KEYWORDS["break"] = "BREAK"
KEYWORDS["continue"] = "CONTINUE"
KEYWORDS["struct"] = "STRUCT"
KEYWORDS["enum"] = "ENUM"
KEYWORDS["case"] = "CASE"
KEYWORDS["match"] = "MATCH"
KEYWORDS["del"] = "DEL"

SINGLE_CHARS = {}
SINGLE_CHARS["("] = "LPAREN"
SINGLE_CHARS[")"] = "RPAREN"
SINGLE_CHARS["["] = "LBRACKET"
SINGLE_CHARS["]"] = "RBRACKET"
SINGLE_CHARS["{"] = "LBRACE"
SINGLE_CHARS["}"] = "RBRACE"
SINGLE_CHARS[","] = "COMMA"
SINGLE_CHARS[":"] = "COLON"
SINGLE_CHARS["."] = "DOT"
SINGLE_CHARS["?"] = "QUESTION"

# ─── Skip whitespace ───

def lex_skip_whitespace(lex):
    while lex.pos < len(lex.src) and (lex.src[lex.pos] == " " or lex.src[lex.pos] == "\t"):
        lex_advance(lex)

# ─── Skip comment ───

def lex_skip_comment(lex):
    while lex.pos < len(lex.src) and lex.src[lex.pos] != "\n":
        lex_advance(lex)

# ─── Handle newline + INDENT/DEDENT ───

def lex_count_indent(lex):
    indent = 0
    while lex.pos < len(lex.src) and lex.src[lex.pos] == " ":
        indent = indent + 1
        lex.pos = lex.pos + 1
        lex.col = lex.col + 1
    return indent

def lex_handle_newline(lex):
    lex_advance(lex)
    lex.line = lex.line + 1
    lex.col = 1
    indent = lex_count_indent(lex)

    while lex.pos < len(lex.src) and (lex.src[lex.pos] == "\n" or lex.src[lex.pos] == "#"):
        if lex.src[lex.pos] == "\n":
            lex_advance(lex)
            lex.line = lex.line + 1
            lex.col = 1
            indent = lex_count_indent(lex)
        elif lex.src[lex.pos] == "#":
            lex_skip_comment(lex)
            if lex.pos < len(lex.src) and lex.src[lex.pos] == "\n":
                lex_advance(lex)
                lex.line = lex.line + 1
                lex.col = 1
                indent = lex_count_indent(lex)

    stack = lex.indent_stack
    current_indent = stack[len(stack) - 1]

    if indent > current_indent:
        stack.append(indent)
        lex_emit(lex, "INDENT_TOK", "", lex.line, lex.col)
    elif indent < current_indent:
        while stack[len(stack) - 1] > indent:
            stack.depend()
            lex_emit(lex, "DEDENT_TOK", "", lex.line, lex.col)
        if stack[len(stack) - 1] != indent:
            print("indentation error")
            return

    lex_emit(lex, "NEWLINE_TOK", "\\n", lex.line, lex.col)

# ─── Read string literal ───

def lex_read_string(lex):
    line = lex.line
    col = lex.col
    lex_advance(lex)
    parts = ""
    while lex.pos < len(lex.src):
        if lex.src[lex.pos] == "\\":
            lex_advance(lex)
            esc = lex_advance(lex)
            if esc == "n":
                parts = parts + "\n"
            elif esc == "t":
                parts = parts + "\t"
            elif esc == "\\":
                parts = parts + "\\"
            elif esc == "\"":
                parts = parts + "\""
            elif esc == "0":
                parts = parts + "\0"
            else:
                parts = parts + esc
        elif lex.src[lex.pos] == "\n":
            print("unterminated string")
            return
        elif lex.src[lex.pos] == "\"":
            lex_advance(lex)
            lex_emit(lex, "STRING_LIT", parts, line, col)
            return
        else:
            parts = parts + lex.src[lex.pos]
            lex_advance(lex)
    print("unterminated string")

# ─── Read number ───

def lex_read_number(lex):
    line = lex.line
    col = lex.col
    start = lex.pos
    is_float = False

    while lex.pos < len(lex.src) and lex.src[lex.pos] >= "0" and lex.src[lex.pos] <= "9":
        lex_advance(lex)

    if lex.pos < len(lex.src) and lex.src[lex.pos] == ".":
        if lex.pos + 1 < len(lex.src) and lex.src[lex.pos + 1] >= "0" and lex.src[lex.pos + 1] <= "9":
            is_float = True
            lex_advance(lex)
            while lex.pos < len(lex.src) and lex.src[lex.pos] >= "0" and lex.src[lex.pos] <= "9":
                lex_advance(lex)

    value = lex.src[start:lex.pos]
    if is_float:
        lex_emit(lex, "FLOAT_LIT", value, line, col)
    else:
        lex_emit(lex, "INT_LIT", value, line, col)

# ─── Read identifier or keyword ───

def lex_read_identifier(lex):
    line = lex.line
    col = lex.col
    start = lex.pos
    while lex.pos < len(lex.src) and ((lex.src[lex.pos] >= "a" and lex.src[lex.pos] <= "z") or (lex.src[lex.pos] >= "A" and lex.src[lex.pos] <= "Z") or (lex.src[lex.pos] >= "0" and lex.src[lex.pos] <= "9") or lex.src[lex.pos] == "_"):
        lex_advance(lex)
    word = lex.src[start:lex.pos]
    tt = null
    if word in KEYWORDS:
        tt = KEYWORDS[word]
    if tt != null:
        lex_emit(lex, tt, word, line, col)
    else:
        lex_emit(lex, "IDENT", word, line, col)

# ─── Main tokenize function ───

def tokenize(source):
    lex = LexerState(source, 0, 1, 1, [0], [], "")
    lex_emit(lex, "NEWLINE_TOK", "\\n", 1, 1)

    while lex.pos < len(lex.src):
        lex.cur_ch = lex.src[lex.pos]

        if lex.cur_ch == "#":
            lex_skip_comment(lex)
        elif lex.cur_ch == "\n":
            lex_handle_newline(lex)
        elif lex.cur_ch == " " or lex.cur_ch == "\t":
            lex_skip_whitespace(lex)
        elif lex.cur_ch == "\"":
            lex_read_string(lex)
        elif lex.cur_ch >= "0" and lex.cur_ch <= "9":
            lex_read_number(lex)
        elif (lex.cur_ch >= "a" and lex.cur_ch <= "z") or (lex.cur_ch >= "A" and lex.cur_ch <= "Z") or lex.cur_ch == "_":
            lex_read_identifier(lex)
        elif lex.cur_ch in SINGLE_CHARS:
            lex_advance(lex)
            lex_emit(lex, SINGLE_CHARS[lex.cur_ch], lex.cur_ch, lex.line, lex.col - 1)
        elif lex.cur_ch == "=":
            lex_advance(lex)
            if lex_peek(lex, 0) == "=":
                lex_advance(lex)
                lex_emit(lex, "EQ", "==", lex.line, lex.col - 2)
            else:
                lex_emit(lex, "ASSIGN", "=", lex.line, lex.col - 1)
        elif lex.cur_ch == "+":
            lex_advance(lex)
            if lex_peek(lex, 0) == "=":
                lex_advance(lex)
                lex_emit(lex, "PLUS_ASSIGN", "+=", lex.line, lex.col - 2)
            else:
                lex_emit(lex, "PLUS", "+", lex.line, lex.col - 1)
        elif lex.cur_ch == "-":
            lex_advance(lex)
            if lex_peek(lex, 0) == "=":
                lex_advance(lex)
                lex_emit(lex, "MINUS_ASSIGN", "-=", lex.line, lex.col - 2)
            else:
                lex_emit(lex, "MINUS", "-", lex.line, lex.col - 1)
        elif lex.cur_ch == "*":
            lex_advance(lex)
            if lex_peek(lex, 0) == "=":
                lex_advance(lex)
                lex_emit(lex, "STAR_ASSIGN", "*=", lex.line, lex.col - 2)
            else:
                lex_emit(lex, "STAR", "*", lex.line, lex.col - 1)
        elif lex.cur_ch == "/":
            lex_advance(lex)
            if lex_peek(lex, 0) == "/":
                lex_advance(lex)
                lex_emit(lex, "DOUBLE_SLASH", "//", lex.line, lex.col - 2)
            elif lex_peek(lex, 0) == "=":
                lex_advance(lex)
                lex_emit(lex, "SLASH_ASSIGN", "/=", lex.line, lex.col - 2)
            else:
                lex_emit(lex, "SLASH", "/", lex.line, lex.col - 1)
        elif lex.cur_ch == "%":
            lex_advance(lex)
            lex_emit(lex, "PERCENT", "%", lex.line, lex.col - 1)
        elif lex.cur_ch == "^":
            lex_advance(lex)
            lex_emit(lex, "POWER", "^", lex.line, lex.col - 1)
        elif lex.cur_ch == "!":
            lex_advance(lex)
            if lex_peek(lex, 0) == "=":
                lex_advance(lex)
                lex_emit(lex, "NEQ", "!=", lex.line, lex.col - 2)
            else:
                print("unexpected character")
                return []
        elif lex.cur_ch == "<":
            lex_advance(lex)
            if lex_peek(lex, 0) == "=":
                lex_advance(lex)
                lex_emit(lex, "LTE", "<=", lex.line, lex.col - 2)
            else:
                lex_emit(lex, "LT", "<", lex.line, lex.col - 1)
        elif lex.cur_ch == ">":
            lex_advance(lex)
            if lex_peek(lex, 0) == "=":
                lex_advance(lex)
                lex_emit(lex, "GTE", ">=", lex.line, lex.col - 2)
            else:
                lex_emit(lex, "GT", ">", lex.line, lex.col - 1)
        else:
            print("unexpected character '" + lex.cur_ch + "'")
            return []

    while len(lex.indent_stack) > 1:
        lex.indent_stack.depend()
        lex_emit(lex, "DEDENT_TOK", "", lex.line, lex.col)

    lex_emit(lex, "EOF_TOK", "", lex.line, lex.col)
    return lex.tokens

# ─── Test ───

src = "def add(a, b):\n    return a + b\n\nx = add(1, 2)\nprint(x)\n"
tokens = tokenize(src)
for tok in tokens:
    print(tok.tt + " " + tok.val)
