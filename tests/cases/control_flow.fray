# if/elif/else
x = 2
if x == 1:
    print("one")
elif x == 2:
    print("two")
else:
    print("other")

# for loop
total = 0
for i in range(5):
    total += i
print(total)  # 10

# while loop
count = 0
while count < 3:
    count += 1
print(count)  # 3

# break
for i in range(10):
    if i == 5:
        break
print(i)  # 5
